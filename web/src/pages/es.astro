];

const esFaqItems = [
  {
    question: 'How does omnibuf-es fit into a protobuf-es (@bufbuild/protobuf) codebase?',
    paragraphs: [
      'Messages in <code>@omnibuf/core</code> follow the <code>@bufbuild/protobuf</code> v2 plain-object design: every message has a <code>$typeName</code> property, optional <code>$unknown</code> field storage, and <code>camelCase</code> field properties that map to <code>snake_case</code> names in Field #0.',
      'The standard lifecycle functions (<code>create</code>, <code>toBinary</code>, <code>fromBinary</code>, <code>mergeFromBinary</code>, <code>clone</code>, <code>equals</code>, and <code>isMessage</code>) accept existing <code>protoc-gen-es</code> descriptors, generated <code>protoc-gen-omnibuf-es</code> schemas, and declarative <code>defineMessage</code> schemas interchangeably.',
    ],
  },
  {
    question: 'When should I use Opaque views instead of fromBinary?',
    paragraphs: [
      'Use <code>fromBinary</code> when your code reads most fields of a message. Use generated <code>Opaque</code> views in edge workers, WebSocket gateways, and telemetry pipelines that only inspect a routing field or update a counter before forwarding the packet.',
      'Getters hop across field headers in one step without decoding untouched strings or sub-messages, and <code>view.marshal()</code> splices modified fields directly onto the underlying <code>Uint8Array</code>.',
    ],
    codeBlock: opaqueSpliceEsCode,
    codeLabel: 'Lazy Read & Zero-Decode Splice',
  },
  {
    question: 'How do I enable Field #0 inline field names or decode without a schema?',
    paragraphs: [
      'Pass <code>{ selfDescribing: true }</code> to <code>toBinary(schema, msg, options)</code> on any schema to emit Field #0 (<code>omnibuf.v1.SchemaMeta</code>) at byte 0 with the root and nested field-name tables.',
      'To inspect a packet without a schema or generated code, call <code>decodeBlind(pkt)</code>. It returns a plain object keyed by field numbers, or by field names automatically when Field #0 is present.',
    ],
    codeBlock: field0BlindEsCode,
    codeLabel: 'Field #0 & Schema-Less Decode',
  },
  {
    question: 'What is the difference between @omnibuf/core, @omnibuf/web, and @omnibuf/node?',
    paragraphs: [
      '<code>@omnibuf/core</code> is a zero-dependency, environment-agnostic runtime that works in browsers, Node.js, Deno, Bun, and Cloudflare Workers.',
      'Importing <code>@omnibuf/web</code> registers a browser codec backed by <code>TextEncoder.encodeInto</code> and adds Web Streams (<code>TransformStream</code>) and DevTools packet inspection helpers. Importing <code>@omnibuf/node</code> registers a <code>Buffer</code>-backed UTF-8 codec, Node stream framing (<code>writeFrame</code>, <code>readFrames</code>), and <code>.fds.json</code> / <code>.fds.pb.gz</code> descriptor loaders.',
    ],
    codeBlock: runtimeAdaptersCode,
    codeLabel: 'Browser & Node.js Adapters',
  },
];

const stripHtml = (s: string) => s.replace(/<[^>]+>/g, '');

const esFaqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: esFaqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.paragraphs.map(stripHtml).join('\n\n'),
    },
  })),
};
---

<Layout
  title="OmniBuf for TypeScript & JS | protobuf-es, defineMessage & protoc-gen-omnibuf-es"
  description="Use OmniBuf in TypeScript and JavaScript: define schemas in TypeScript, drop in on existing @bufbuild/protobuf descriptors, or generate single-pass codecs and Opaque views."
>
  <Navbar currentPage="es" />

  <main id="main-content">
    <!-- Page Header + Up-Front Install Bar -->
    <section class="relative pt-10 pb-8 sm:pt-16 sm:pb-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
      <h1 class="text-[2.6rem] sm:text-7xl lg:text-[5.5rem] font-bold tracking-tight leading-[0.94] text-ink uppercase">
        OmniBuf
        <br />
        <span class="font-serif italic font-normal normal-case text-[#FF4F18] text-[3.1rem] sm:text-8xl lg:text-[6.2rem]">
          for TypeScript &amp; JS.
        </span>
      </h1>

      <div class="mt-6 grid lg:grid-cols-12 gap-6 lg:gap-8 items-end">
        <div class="lg:col-span-7 space-y-4">
          <p class="text-lg sm:text-2xl text-ink/85 font-medium leading-snug">
            Runtime and code generator for Node.js, browsers, and edge workers: serialize{' '}
            <a href="#define-message" class="doc-link">
              declarative TypeScript schemas
            </a>
            , drop in on{' '}
            <a href="#protobuf-es" class="doc-link">
              @bufbuild/protobuf descriptors
            </a>
            , or generate single-pass codecs and lazy{' '}
            <a href="#plugin-codegen" class="doc-link">
              Opaque views
            </a>{' '}
            (see the{' '}
            <a href="#benchmarks" class="doc-link">
              TypeScript &amp; JS benchmarks
            </a>{' '}
            below).
          </p>
          <div class="flex flex-wrap gap-3 font-mono text-sm sm:text-base pt-1 no-print">
            <a
              href="https://github.com/sudorandom/omnibuf-es"
              target="_blank"
              rel="noopener noreferrer"
              class="os-btn px-4 py-2.5 bg-acid text-ink font-bold rounded-md"
            >
              GitHub Repository (omnibuf-es) &rarr;
            </a>
            <a href="/spec" class="os-btn px-4 py-2.5 bg-[#FAF8F2] text-ink font-bold rounded-md">
              Wire Specification &rarr;
            </a>
          </div>
        </div>

        <div class="lg:col-span-5 space-y-3 min-w-0">
          <div class="p-4 bg-ink text-paper rounded-md font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border-2 border-ink shadow-[4px_4px_0px_#111111]">
            <div class="flex items-center justify-between gap-2 mb-2 pb-2 border-b border-paper/15">
              <div class="text-xs font-bold uppercase text-acid">Core Runtime (Universal)</div>
              <button
                type="button"
                data-copy="pnpm add @omnibuf/core"
                class="copy-snippet-btn min-w-[4.75rem] text-center px-2.5 py-1 text-xs font-bold uppercase bg-paper/15 hover:bg-acid hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-acid text-paper border border-paper/30 rounded shrink-0 transition"
              >
                Copy
              </button>
            </div>
            <pre class="leading-relaxed whitespace-pre"><code><span class="text-paper/75 select-none">$ </span>pnpm add @omnibuf/core</code></pre>
          </div>

          <div class="p-4 bg-ink text-paper rounded-md font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border-2 border-ink shadow-[4px_4px_0px_#111111]">
            <div class="flex items-center justify-between gap-2 mb-2 pb-2 border-b border-paper/15">
              <div class="text-xs font-bold uppercase text-acid">
                Browser &amp; Edge (@omnibuf/web)
              </div>
              <button
                type="button"
                data-copy="pnpm add @omnibuf/web"
                class="copy-snippet-btn min-w-[4.75rem] text-center px-2.5 py-1 text-xs font-bold uppercase bg-paper/15 hover:bg-acid hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-acid text-paper border border-paper/30 rounded shrink-0 transition"
              >
                Copy
              </button>
            </div>
            <pre class="leading-relaxed whitespace-pre"><code><span class="text-paper/75 select-none">$ </span>pnpm add @omnibuf/web</code></pre>
          </div>

          <div class="p-4 bg-ink text-paper rounded-md font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border-2 border-ink shadow-[4px_4px_0px_#111111]">
            <div class="flex items-center justify-between gap-2 mb-2 pb-2 border-b border-paper/15">
              <div class="text-xs font-bold uppercase text-acid">Node.js (@omnibuf/node)</div>
              <button
                type="button"
                data-copy="pnpm add @omnibuf/node"
                class="copy-snippet-btn min-w-[4.75rem] text-center px-2.5 py-1 text-xs font-bold uppercase bg-paper/15 hover:bg-acid hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-acid text-paper border border-paper/30 rounded shrink-0 transition"
              >
                Copy
              </button>
            </div>
            <pre class="leading-relaxed whitespace-pre"><code><span class="text-paper/75 select-none">$ </span>pnpm add @omnibuf/node</code></pre>
          </div>
        </div>
      </div>
    </section>

    <!-- Three Ways to Use OmniBuf in TypeScript & JS -->
    <section
      id="quickstart"
      class="scroll-mt-16 py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-t-2 border-ink/15"
    >
      <div class="max-w-3xl mb-8">
        <h2 class="text-3xl sm:text-5xl font-bold tracking-tight uppercase leading-none">
          Three ways to use{' '}
          <span class="font-serif italic font-normal normal-case text-[#FF4F18]">
            OmniBuf in TypeScript.
          </span>
        </h2>
        <p class="mt-3 text-lg sm:text-xl text-ink/80 font-medium">
          Define schemas directly in TypeScript, pass existing <code>@bufbuild/protobuf</code>{' '}
          descriptors with no build changes, or generate single-pass codecs and lazy{' '}
          <code>Opaque</code> views with the compiler plugin.
        </p>
      </div>

      <div class="border-t-2 border-ink divide-y-2 divide-ink/20">
        <!-- 1. Declarative TypeScript Schemas -->
        <div
          id="define-message"
          class="scroll-mt-16 py-8 sm:py-12 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start"
        >
          <div class="lg:col-span-5 space-y-3.5 min-w-0">
            <h3 class="text-2xl sm:text-3xl font-bold uppercase tracking-tight leading-snug">
              Declarative TypeScript schemas
            </h3>
            <p class="text-base sm:text-lg text-ink/85 leading-relaxed">
              Define a schema in TypeScript with <code>defineMessage</code> (or decorate a class
              with <code>@omnibufMessage</code> and <code>@omnibufField</code>) and pass it to{' '}
              <code>create</code>, <code>toBinary</code>, and <code>fromBinary</code>:
            </p>
            <ul class="space-y-2 text-sm sm:text-base text-ink/85 leading-relaxed list-disc pl-5">
              <li>
                <code>fieldNum</code> sets the wire field number (<code>1..65535</code>).
              </li>
              <li>
                <code>name</code> sets the wire field name written to Field #0 (defaults to{' '}
                <code>snake_case</code> of the TypeScript property name).
              </li>
              <li>
                <code>type</code> selects the wire encoding (<code>uint32</code>,{' '}
                <code>uint64</code>, <code>sint32</code>, <code>sint64</code>, <code>fixed32</code>,{' '}
                <code>fixed64</code>, <code>float</code>, <code>double</code>, <code>bool</code>,{' '}
                <code>string</code>, <code>bytes</code>, <code>message</code>, or <code>map</code>).
              </li>
              <li>
                <code>omitEmpty</code> skips encoding when the field holds its default value.
              </li>
            </ul>
          </div>

          <div class="lg:col-span-7 min-w-0">
            <div class="p-4 sm:p-5 bg-ink text-paper rounded-md font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border-2 border-ink [&>pre]:!bg-transparent [&>pre]:!p-0 [&>pre]:!m-0 [&>pre]:!border-0">
              <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/15">
                <div class="text-xs font-bold uppercase text-acid">defineMessage Schema</div>
                <button
                  type="button"
                  data-copy={defineMessageSnippet}
                  class="copy-snippet-btn min-w-[4.75rem] text-center px-2.5 py-1 text-xs font-bold uppercase bg-paper/15 hover:bg-acid hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-acid text-paper border border-paper/30 rounded shrink-0 transition"
                >
                  Copy
                </button>
              </div>
              <Code code={defineMessageSnippet} lang="ts" theme="github-dark" />
            </div>
          </div>
        </div>

        <!-- 2. Existing @bufbuild/protobuf Descriptors -->
        <div
          id="protobuf-es"
          class="scroll-mt-16 py-8 sm:py-12 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start"
        >
          <div class="lg:col-span-5 space-y-3.5 min-w-0">
            <h3 class="text-2xl sm:text-3xl font-bold uppercase tracking-tight leading-snug">
              Existing @bufbuild/protobuf schemas
            </h3>
            <p class="text-base sm:text-lg text-ink/85 leading-relaxed">
              Already generating TypeScript descriptors with <code>protoc-gen-es</code>? Pass your
              existing <code>DescMessage</code> schemas directly to <code>create</code>,{' '}
              <code>toBinary</code>, <code>fromBinary</code>, and <code>mergeFromBinary</code> with
              no extra plugin step.
            </p>
            <p class="text-base sm:text-lg text-ink/85 leading-relaxed">
              OmniBuf compiles each <code>DescMessage</code> into a cached field-dispatch table on
              first use, preserving unknown fields in <code>$unknown</code> and supporting both{' '}
              <code>proto3</code> and Editions 2023/2024 descriptors.
            </p>
          </div>

          <div class="lg:col-span-7 min-w-0">
            <div class="p-4 sm:p-5 bg-ink text-paper rounded-md font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border-2 border-ink [&>pre]:!bg-transparent [&>pre]:!p-0 [&>pre]:!m-0 [&>pre]:!border-0">
              <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/15">
                <div class="text-xs font-bold uppercase text-acid">
                  Existing @bufbuild/protobuf Descriptors
                </div>
                <button
                  type="button"
                  data-copy={protobufEsSnippet}
                  class="copy-snippet-btn min-w-[4.75rem] text-center px-2.5 py-1 text-xs font-bold uppercase bg-paper/15 hover:bg-acid hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-acid text-paper border border-paper/30 rounded shrink-0 transition"
                >
                  Copy
                </button>
              </div>
              <Code code={protobufEsSnippet} lang="ts" theme="github-dark" />
            </div>
          </div>
        </div>

        <!-- 3. Generated Code with protoc-gen-omnibuf-es -->
        <div
          id="plugin-codegen"
          class="scroll-mt-16 py-8 sm:py-12 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start"
        >
          <div class="lg:col-span-5 space-y-3.5 min-w-0">
            <h3 class="text-2xl sm:text-3xl font-bold uppercase tracking-tight leading-snug">
              Generated code with protoc-gen-omnibuf-es
            </h3>
            <p class="text-base sm:text-lg text-ink/85 leading-relaxed">
              Add <code>protoc-gen-omnibuf-es</code> to your <code>buf.gen.yaml</code>. The plugin
              generates typed <code>Message</code> interfaces, single-pass encoders and switch-based
              decoders, and lazy <code>Opaque</code> wrapper classes.
            </p>
            <p class="text-base sm:text-lg text-ink/85 leading-relaxed">
              <code>Opaque</code> views read individual fields directly from the{' '}
              <code>Uint8Array</code> packet via <code>locateField</code> and re-serialize modified
              packets using <code>spliceFields</code> without decoding untouched fields.
            </p>
          </div>

          <div class="lg:col-span-7 space-y-3.5 min-w-0">
            <div class="p-4 sm:p-5 bg-ink text-paper rounded-md font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border-2 border-ink [&>pre]:!bg-transparent [&>pre]:!p-0 [&>pre]:!m-0 [&>pre]:!border-0">
              <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/15">
                <div class="text-xs font-bold uppercase text-acid">buf.gen.yaml</div>
                <button
