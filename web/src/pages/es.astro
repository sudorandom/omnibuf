    maxVal: 3000,
    methodology:
      'Measures decoding the full 11-field PeerUpdate packet back into a typed JavaScript message object. Generated OmniBuf schemas dispatch on Prefix-Varint tags in a single switch loop without reflection, reading strings and submessages in place without intermediate subarray slices.',
    rows: [
      {
        name: 'OmniBuf',
        val: 826,
        ops: '1,210,766 ops/s',
        highlight: true,
        baseline: true,
      },
      {
        name: 'protobufjs',
        val: 1195,
