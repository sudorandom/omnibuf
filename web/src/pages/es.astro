    unit: 'ns',
    maxVal: 7500,
    methodology:
      'Measures updating a 64-bit sequence counter on an in-flight packet and producing the updated wire bytes. OmniBuf splices the modified field directly onto the raw Uint8Array packet without decoding or re-encoding untouched fields.',
    rows: [
      {
        name: 'OmniBuf',
