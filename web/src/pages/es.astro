    methodology:
      'Measures extracting a nested string field (peer.location.city) from a serialized packet. OmniBuf hops across preceding field headers in O(1) time per field using TZCNT length prefixes without decoding untouched strings, arrays, or submessages.',
    rows: [
      {
        name: 'OmniBuf',
        val: 363,
        ops: '2,751,375 ops/s',
        highlight: true,
