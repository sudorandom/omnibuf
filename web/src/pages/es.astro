        val: 2665,
        ops: '375,248 ops/s',
      },
      {
        name: '@msgpack/msgpack',
        val: 2824,
        ops: '354,064 ops/s',
      },
      {
        name: '@bufbuild/protobuf (protobuf-es)',
        val: 2996,
