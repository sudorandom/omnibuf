---
import { Code } from 'astro:components';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const defineMessageSnippet = `import {
  defineMessage,
  create,
  toBinary,
  fromBinary,
  type Message,
} from '@omnibuf/core';

interface Peer extends Message<'app.Peer'> {
  peerId: number;
  router: string;
  active: boolean;
  prefixes: number[];
}

const PeerSchema = defineMessage<Peer, 'app.Peer'>('app.Peer', {
  peerId: { fieldNum: 1, name: 'peer_id', type: 'uint32' },
  router: { fieldNum: 2, type: 'string', omitEmpty: true },
  active: { fieldNum: 3, type: 'bool' },
  prefixes: { fieldNum: 4, type: 'uint32', repeated: true },
});

const peer = create(PeerSchema, {
  peerId: 64512,
  router: 'rtr-01',
  active: true,
});
const pkt = toBinary(PeerSchema, peer);
const out = fromBinary(PeerSchema, pkt);`;

const protobufEsSnippet = `import {
  create,
  toBinary,
  fromBinary,
} from '@omnibuf/core';
// Standard protoc-gen-es descriptor:
import { PeerUpdateSchema } from './gen/peer_pb.js';

const msg = create(PeerUpdateSchema, {
  asn: 64512,
  routerId: 'edge-rtr-fra01',
  active: true,
});
const pkt = toBinary(PeerUpdateSchema, msg);
const out = fromBinary(PeerUpdateSchema, pkt);`;

const bufGenEsSnippet = `version: v2
plugins:
  - local: protoc-gen-omnibuf-es
    out: src/gen
    opt: target=ts`;

const generatedEsSnippet = `import {
  create,
  toBinary,
  fromBinary,
} from '@omnibuf/core';
import {
  PeerUpdateSchema,
  OpaquePeerUpdate,
} from './gen/peer_omnibuf.pb.js';

const msg = create(PeerUpdateSchema, {
  asn: 64512,
  routerId: 'rtr-01',
  active: true,
});
const pkt = toBinary(PeerUpdateSchema, msg);

// Lazy Opaque view: O(1) hop + zero-decode splice
const view = new OpaquePeerUpdate(pkt);
if (view.getActive() && view.getAsn() === 64512) {
  view.setSequence(99n);
  const forwarded = view.marshal();
}`;

const opaqueSpliceEsCode = `const view = new OpaquePeerUpdate(pkt);
const router = view.getRouterId(); // O(1) header hop

// Update field #3 (active) and field #11 (sequence) in place:
view.setActive(false);
view.setSequence(42n);
const updated = view.marshal();`;

const field0BlindEsCode = `import { toBinary, decodeBlind } from '@omnibuf/core';

// Prepend Field #0 (SchemaMeta) inline with the packet:
const pkt = toBinary(PeerSchema, peer, {
  selfDescribing: true,
});

// Decode any OmniBuf packet without a schema:
const fields = decodeBlind(pkt);`;

const runtimeAdaptersCode = `// Browser / Edge: TextEncoder.encodeInto + Web Streams
import {
  createOmniBufDecodeStream,
  inspectPacket,
} from '@omnibuf/web';

// Node.js: Buffer UTF-8 codec + stream framing
import { writeFrame, readFrames } from '@omnibuf/node';`;

interface EsBenchmarkRow {
  name: string;
  val: number;
  ops: string;
  sizeBytes?: number;
  highlight?: boolean;
  baseline?: boolean;
}

interface EsBenchmarkCategory {
  title: string;
  unit: string;
  maxVal: number;
  methodology: string;
  rows: EsBenchmarkRow[];
}

