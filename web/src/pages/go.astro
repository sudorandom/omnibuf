---
import { Code } from 'astro:components';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Quickstart from '../components/Quickstart.astro';
import Benchmarks from '../components/Benchmarks.astro';
import Footer from '../components/Footer.astro';

const opaqueSpliceCode = `view := pb.PeerOpaque(pkt)
router, ok := view.Router()
updated := view.SetActive(false)`;

const field0BlindCode = `opts := omnibuf.MarshalOptions{SelfDescribing: true}
pkt, err := opts.Marshal(&peer)
fields, err := omnibuf.DecodeBlind(pkt)`;

const zeroCopyBufferCode = `buf = msg.MarshalOmniBufAppend(buf[:0])
err := out.UnmarshalOmniBuf(buf, true)`;

const goFaqItems = [
  {
    id: 'go-faq-opaque',
    question: 'Do I have to parse the whole message to read one field?',
    paragraphs: [
      'No. While <code>omnibuf.Unmarshal</code> decodes a full message buffer into a struct, generated <code>Opaque</code> views (and low-level helpers like <code>wire.LocateField</code> or <code>wire.ReadString</code>) hop over preceding field headers by byte length and read or splice just the field you asked for without parsing or allocating the rest of the packet.',
    ],
    codeBlock: opaqueSpliceCode,
    codeLabel: 'Example',
  },
  {
    id: 'go-faq-blind',
    question: 'How do I decode without a schema?',
    paragraphs: [
      'Call <code>omnibuf.DecodeBlind(pkt)</code> to decode any packet into a map keyed by field number. If you also want field names in that map, encode with <code>MarshalOptions{SelfDescribing: true}</code> to include Field #0.',
    ],
    codeBlock: field0BlindCode,
    codeLabel: 'Example',
  },
  {
    id: 'go-faq-zerocopy',
    question: 'What does zeroCopy do?',
    paragraphs: [
      'Passing <code>true</code> to <code>UnmarshalOmniBuf(pkt, true)</code> points Go strings straight at the <code>pkt</code> slice instead of allocating and copying. Only use <code>true</code> if <code>pkt</code> will not be overwritten while the struct is still in use.',
    ],
    codeBlock: zeroCopyBufferCode,
    codeLabel: 'Example',
  },
  {
    id: 'go-faq-plugin',
    question: 'Do I need protoc-gen-omnibuf?',
    paragraphs: [
      'It is optional, though worth adding when you want maximum speed. <code>omnibuf.Marshal</code> and <code>omnibuf.Unmarshal</code> already run ~2x faster than <code>proto.Marshal</code> with no extra plugin, and adding <code>protoc-gen-omnibuf</code> gives you ~6x faster generated methods plus <code>Opaque</code> views over OmniBuf packets.',
    ],
  },
];

const stripHtml = (s: string) => s.replace(/<[^>]+>/g, '');

const goFaqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: goFaqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.paragraphs.map(stripHtml).join('\n\n'),
    },
  })),
};
---

<Layout
  title="OmniBuf for Go | Struct Tags, Protobuf Structs & protoc-gen-omnibuf"
  description="Use OmniBuf in Go: serialize plain Go structs with omnibuf struct tags, drop in on standard Protobuf structs, or generate single-pass codecs and lazy Opaque readers with protoc-gen-omnibuf."
>
  <Navbar currentPage="go" />

  <main id="main-content">
    <!-- Page Header + Up-Front Install Bar -->
    <section class="relative pt-10 pb-8 sm:pt-16 sm:pb-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
      <h1 class="text-[2.6rem] sm:text-7xl lg:text-[5.5rem] font-bold tracking-tight leading-[0.94] text-ink uppercase">
        OmniBuf
        <br />
        <span class="font-serif italic font-normal normal-case text-[#FF4F18] text-[3.1rem] sm:text-8xl lg:text-[6.2rem]">
          for Go.
        </span>
      </h1>

      <div class="mt-6 grid lg:grid-cols-12 gap-6 lg:gap-8 items-end">
        <div class="lg:col-span-7 space-y-4">
          <p class="text-lg sm:text-2xl text-ink/85 font-medium leading-snug">
            You can use OmniBuf in Go on{' '}
            <a href="#struct-tags" class="doc-link">
              plain Go structs
            </a>
            , existing{' '}
            <a href="#pb-go-structs" class="doc-link">
              standard Protobuf structs
            </a>
            , or with the{' '}
            <a href="#plugin-tiers" class="doc-link">
              protoc-gen-omnibuf plugin
            </a>
            . Check the{' '}
            <a href="#benchmarks" class="doc-link">
              Go benchmarks
            </a>{' '}
            below to see how each option performs.
          </p>
          <div class="flex flex-wrap gap-3 font-mono text-sm sm:text-base pt-1 no-print">
            <a
              href="https://github.com/sudorandom/omnibuf"
              target="_blank"
              rel="noopener noreferrer"
              class="os-btn px-4 py-2.5 bg-acid text-ink font-bold rounded-md"
            >
              GitHub Repository &rarr;
            </a>
            <a
              href="https://pkg.go.dev/github.com/sudorandom/omnibuf"
              target="_blank"
              rel="noopener noreferrer"
              class="os-btn px-4 py-2.5 bg-[#FAF8F2] text-ink font-bold rounded-md"
            >
              pkg.go.dev Reference &rarr;
            </a>
          </div>
        </div>

        <div class="lg:col-span-5 min-w-0">
          <div class="p-4 sm:p-5 bg-ink text-paper rounded-md font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border-2 border-ink shadow-[4px_4px_0px_#111111]">
            <div class="flex items-center justify-between gap-2 mb-2 pb-2 border-b border-paper/15">
              <div class="text-xs font-bold uppercase text-acid">Install Go Runtime</div>
              <button
                type="button"
                data-copy="go get github.com/sudorandom/omnibuf"
                class="copy-snippet-btn min-w-[4.75rem] text-center px-2.5 py-1 text-xs font-bold uppercase bg-paper/15 hover:bg-acid hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-acid text-paper border border-paper/30 rounded shrink-0 transition"
              >
                Copy
              </button>
            </div>
            <pre class="leading-relaxed whitespace-pre"><code><span class="text-paper/75 select-none">$ </span>go get github.com/sudorandom/omnibuf</code></pre>
          </div>
        </div>
      </div>
    </section>

    <!-- Three Ways to Use OmniBuf in Go -->
    <Quickstart />

    <!-- Go Benchmarks -->
    <Benchmarks />

    <!-- Go FAQ -->
    <section
      id="go-faq"
      class="scroll-mt-16 py-16 sm:py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-t-2 border-ink/15"
    >
      <div class="max-w-3xl mb-10">
        <h2 class="text-3xl sm:text-5xl font-bold tracking-tight uppercase leading-none">
          Go{' '}
          <span class="font-serif italic font-normal normal-case text-[#FF4F18]">questions.</span>
        </h2>
      </div>

      <div class="border-t-2 border-ink divide-y-2 divide-ink/20">
        {goFaqItems.map((item) => (
          <div
            id={item.id}
            class="scroll-mt-16 py-8 sm:py-10 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start"
          >
            <h3 class="lg:col-span-5 text-xl sm:text-2xl font-bold uppercase tracking-tight text-ink leading-snug">
              {item.question}
            </h3>

            <div class="lg:col-span-7 space-y-3.5 text-base sm:text-lg text-ink/85 leading-relaxed max-w-[65ch] min-w-0">
              {item.paragraphs.map((paragraph) => (
                <p set:html={paragraph} />
              ))}
              {item.codeBlock && (
                <div class="bg-ink text-paper p-4 sm:p-5 rounded-md border-2 border-ink font-mono text-xs sm:text-sm leading-relaxed overflow-x-auto [&>pre]:!bg-transparent [&>pre]:!p-0 [&>pre]:!m-0 [&>pre]:!border-0">
                  <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/15">
                    <div class="text-xs font-bold uppercase text-acid">
                      {item.codeLabel ?? 'Example'}
                    </div>
                    <button
                      type="button"
                      data-copy={item.codeBlock}
                      class="copy-snippet-btn min-w-[4.75rem] text-center px-2.5 py-1 text-xs font-bold uppercase bg-paper/15 hover:bg-acid hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-acid text-paper border border-paper/30 rounded shrink-0 transition"
                    >
                      Copy
                    </button>
                  </div>
                  <Code code={item.codeBlock} lang="go" theme="github-dark" />
                </div>
              )}
            </div>
          </div>
        ))}
      </div>

      <script is:inline type="application/ld+json" set:html={JSON.stringify(goFaqJsonLd)} />
    </section>

    <section class="py-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-t-2 border-ink no-print">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div class="font-mono text-sm sm:text-base font-bold uppercase text-ink/80">
          More about the wire format
        </div>
        <div class="flex flex-wrap gap-3 font-mono text-sm sm:text-base">
          <a href="/how-it-works" class="os-btn px-5 py-2.5 bg-acid text-ink font-bold rounded-md">
            How It Works &rarr;
          </a>
          <a href="/es" class="os-btn px-5 py-2.5 bg-[#FAF8F2] text-ink font-bold rounded-md">
            TypeScript / JS &rarr;
          </a>
          <a href="/spec" class="os-btn px-5 py-2.5 bg-[#FAF8F2] text-ink font-bold rounded-md">
            Wire Specification &rarr;
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
