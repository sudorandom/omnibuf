---
import { Code } from 'astro:components';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const zigZagGoCode = `// Encode signed int64 -> unsigned uint64:
u := uint64((n << 1) ^ (n >> 63))

// Decode unsigned uint64 -> signed int64:
n := int64(u >> 1) ^ -int64(u & 1)`;

const locateFieldGoCode = `// Jump from field to field in O(1) time without parsing inside containers:
for pos < len(packet) {
    tag, tn := DecodeVarint(packet[pos:])
    pos += tn
    fnum, wtype := uint16(tag>>4), uint8(tag&0x0F)

    if fnum == targetField {
        valSlice, wireType, found = packet[pos:], wtype, true
    }
    pos = SkipValue(packet, pos, wtype) // pos += scalarWidth or container ByteLen
}`;

const sec8MetaProtoCode = `syntax = "proto3";
package omnibuf.v1;

// Written at Field #0 (Tag = 0x0B, WireSubMsg = 5) when self-describing mode is enabled.
message SchemaMeta {
  string type_name = 1;               // Optional message name (e.g. "Location")
  map<uint32, string> fields = 2;     // FieldNumber -> FieldName (e.g. 3 -> "city")
  map<uint32, SchemaMeta> children = 3; // Parent FieldNumber -> child SchemaMeta (stored once)
}`;

const sec9ProtoCode = `message Location {
  string city = 3; // "FRA"
  uint32 rack = 4; // 42
}

message Node {
  uint32   id       = 1; // 300
  bool     active   = 3; // true
  Location location = 9; // { city: "FRA", rack: 42 }
}`;

const tocSections = [
