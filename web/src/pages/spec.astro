const zigZagGoCode = `// Encoding (int64 -> uint64):
u := uint64((n << 1) ^ (n >> 63)) // arithmetic right shift by 63 bits

// Decoding (uint64 -> int64):
n := int64(u >> 1) ^ -int64(u & 1)`;

const locateFieldGoCode = `// LocateField scans packet via branchless TZCNT header hops (O(1) per-field skip)
// and returns the value slice of the last occurrence of targetField.
pos := 0
var valSlice []byte
var wireType uint8
found := false

for pos < len(packet) {
    tag, tn := DecodeVarint(packet[pos:])
    if tn == 0 {
        return absent
    }
    pos += tn
    fnum  := uint16(tag >> 4)
    wtype := uint8(tag & 0x0F)

    if fnum == targetField {
        valSlice = packet[pos:]
        wireType = wtype
        found = true
    }
    pos = SkipValue(packet, pos, wtype)
}
return valSlice, wireType, found`;

const sec8MetaProtoCode = `syntax = "proto3";
package omnibuf.v1;

// Encoded as Field #0 (Tag = 0x0B, WireSubMsg = 5) at byte 0 of a message.
message SchemaMeta {
  // Optional protobuf message type name (e.g., "PeerUpdate" or "acme.v1.Node").
  string type_name = 1;

  // Maps FieldNumber -> FieldName (e.g., 1 -> "id", 3 -> "active", 9 -> "location").
  // Encoded as WireMap (9) with MapType = 0x03 (KeyWT = WireUint(0), ValWT = WireString(3)).
  map<uint32, string> fields = 2;

  // Maps a parent FieldNumber (for a WireSubMsg, WireSubMsgArr, or WireMap value)
  // to its nested SchemaMeta so repeated sub-messages only encode their schema ONCE.
  // Encoded as WireMap (9) with MapType = 0x05 (KeyWT = WireUint(0), ValWT = WireSubMsg(5)).
  map<uint32, SchemaMeta> children = 3;
}`;

const sec9ProtoCode = `message Location {
  string city = 3; // "FRA"
  uint32 rack = 4; // 42
}

message Node {
  uint32   id       = 1; // 300
  bool     active   = 3; // true
  Location location = 9; // { city: "FRA", rack: 42 }
}`;

