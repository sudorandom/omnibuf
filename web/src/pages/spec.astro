<script>
  const specLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('a[data-spec-link]'));
  const subTocContainers = Array.from(document.querySelectorAll<HTMLElement>('div[data-subtoc]'));
  const h3Links = Array.from(document.querySelectorAll<HTMLAnchorElement>('a[data-spec-h3]'));
  const specIds = specLinks.map((l) => l.dataset.specLink || '');

  function updateSpecToc() {
    const scrollPos = window.scrollY + 140;
    let currentH2 = specIds[0];
    for (const id of specIds) {
      const el = document.getElementById(id);
      if (el && el.offsetTop <= scrollPos) {
        currentH2 = id;
      }
    }

    for (const link of specLinks) {
      link.dataset.active = link.dataset.specLink === currentH2 ? 'true' : 'false';
    }

    // Expand only the active H2's H3 list
    for (const sub of subTocContainers) {
      if (sub.dataset.subtoc === currentH2) {
        sub.classList.remove('hidden');
        sub.classList.add('block');
      } else {
        sub.classList.remove('block');
        sub.classList.add('hidden');
      }
    }

    // Highlight active H3 inside the expanded H2 section
    const activeSubContainer = document.querySelector<HTMLElement>(
      `div[data-subtoc="${currentH2}"]`,
    );
    let currentH3 = '';
    if (activeSubContainer) {
      const activeH3Links = Array.from(
        activeSubContainer.querySelectorAll<HTMLAnchorElement>('a[data-spec-h3]'),
      );
      for (const l of activeH3Links) {
        const h3Id = l.dataset.specH3 || '';
        const h3El = document.getElementById(h3Id);
        if (h3El && h3El.offsetTop <= scrollPos + 20) {
          currentH3 = h3Id;
        }
      }
    }

    for (const l of h3Links) {
      l.dataset.active = l.dataset.specH3 === currentH3 && currentH3 !== '' ? 'true' : 'false';
    }
  }

  window.addEventListener('scroll', updateSpecToc, { passive: true });
  updateSpecToc();

  const mobileTocDetails = document.getElementById('mobile-spec-toc') as HTMLDetailsElement | null;
  if (mobileTocDetails) {
    for (const link of Array.from(
      mobileTocDetails.querySelectorAll<HTMLAnchorElement>('a[data-mobile-spec-link]'),
    )) {
      link.addEventListener('click', () => {
        mobileTocDetails.open = false;
      });
    }
  }

  // Add pilcrow (¶) copy-link anchors to every section heading in the specification
  const specHeadings = Array.from(
    document.querySelectorAll<HTMLElement>(
      '.spec-prose h2[id], .spec-prose h3[id], .spec-prose h4[id]',
    ),
  );
  for (const heading of specHeadings) {
    const id = heading.id;
    if (!id) continue;
    const anchor = document.createElement('a');
    anchor.href = `#${id}`;
    anchor.className = 'spec-anchor no-print';
    anchor.textContent = '¶';
    anchor.title = 'Copy link to section';
    anchor.setAttribute('aria-label', 'Copy link to section');
    anchor.addEventListener('click', (e) => {
      e.preventDefault();
      const url = `${window.location.origin}${window.location.pathname}#${id}`;
      history.replaceState(null, '', `#${id}`);
      heading.scrollIntoView({ behavior: 'smooth', block: 'start' });
      if (navigator.clipboard && navigator.clipboard.writeText) {
        void navigator.clipboard.writeText(url);
      }
      anchor.dataset.copied = 'true';
      anchor.textContent = 'Copied!';
      window.setTimeout(() => {
        anchor.dataset.copied = 'false';
        anchor.textContent = '¶';
      }, 1400);
    });
    heading.appendChild(anchor);
  }
</script>
