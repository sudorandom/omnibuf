<script>
  const specLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('a[data-spec-link]'));
  const subTocContainers = Array.from(document.querySelectorAll<HTMLElement>('div[data-subtoc]'));
  const h3Links = Array.from(document.querySelectorAll<HTMLAnchorElement>('a[data-spec-h3]'));
  const mobileSpecLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('a[data-mobile-spec-link]'),
  );
  const mobileTocLabel = document.getElementById('mobile-spec-toc-label');
  const specIds = specLinks.map((l) => l.dataset.specLink || '');

  function updateSpecToc() {
    let currentH2 = specIds[0];
    for (const id of specIds) {
      const el = document.getElementById(id);
      if (el && el.getBoundingClientRect().top <= 160) {
        currentH2 = id;
      }
    }

    for (const link of specLinks) {
      const isActive = link.dataset.specLink === currentH2;
      link.dataset.active = isActive ? 'true' : 'false';
      if (isActive && mobileTocLabel) {
        mobileTocLabel.textContent = `Section: ${link.textContent?.trim() || 'Jump to Spec Section'}`;
      }
    }

    // Keep Section 6 (Wire Types 6.1-6.11) always expanded, plus expand the active H2's H3 list
    for (const sub of subTocContainers) {
      if (sub.dataset.subtoc === currentH2 || sub.dataset.subtoc === 'sec-6') {
        sub.classList.remove('hidden');
        sub.classList.add('block');
      } else {
        sub.classList.remove('block');
        sub.classList.add('hidden');
      }
    }

    // Highlight active H3 inside the expanded H2 section
    const activeSubContainer = document.querySelector<HTMLElement>(
      `div[data-subtoc="${currentH2}"]`,
    );
    let currentH3 = '';
    if (activeSubContainer) {
      const activeH3Links = Array.from(
        activeSubContainer.querySelectorAll<HTMLAnchorElement>('a[data-spec-h3]'),
      );
      for (const l of activeH3Links) {
        const h3Id = l.dataset.specH3 || '';
        const h3El = document.getElementById(h3Id);
        if (h3El && h3El.getBoundingClientRect().top <= 180) {
          currentH3 = h3Id;
        }
      }
    }

    for (const l of h3Links) {
      l.dataset.active = l.dataset.specH3 === currentH3 && currentH3 !== '' ? 'true' : 'false';
    }

    for (const ml of mobileSpecLinks) {
      const targetId = ml.dataset.mobileSpecLink || '';
      ml.dataset.active =
        targetId === currentH2 || (targetId === currentH3 && currentH3 !== '') ? 'true' : 'false';
    }
  }

  window.addEventListener('scroll', updateSpecToc, { passive: true });
  updateSpecToc();

  const mobileTocDetails = document.getElementById('mobile-spec-toc') as HTMLDetailsElement | null;
  if (mobileTocDetails) {
    for (const link of Array.from(
      mobileTocDetails.querySelectorAll<HTMLAnchorElement>('a[data-mobile-spec-link]'),
    )) {
      link.addEventListener('click', () => {
        mobileTocDetails.open = false;
      });
    }
    document.addEventListener('click', (e) => {
      if (mobileTocDetails.open && !mobileTocDetails.contains(e.target as Node)) {
        mobileTocDetails.open = false;
      }
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && mobileTocDetails.open) {
        mobileTocDetails.open = false;
      }
    });
  }

  // Add pilcrow (¶) copy-link anchors to every section heading in the specification
  const specLiveRegion = document.getElementById('spec-copy-live');
  const anchorTimers = new WeakMap<HTMLAnchorElement, number>();
  const specHeadings = Array.from(
    document.querySelectorAll<HTMLElement>(
      '.spec-prose h2[id], .spec-prose h3[id], .spec-prose h4[id]',
    ),
  );
  for (const heading of specHeadings) {
    const id = heading.id;
    if (!id) continue;
    const anchor = document.createElement('a');
    anchor.href = `#${id}`;
    anchor.className = 'spec-anchor no-print';
    anchor.textContent = '¶';
    anchor.title = 'Copy link to section';
    anchor.setAttribute('aria-label', 'Copy link to section');
    anchor.addEventListener('click', (e) => {
      e.preventDefault();
      const url = `${window.location.origin}${window.location.pathname}#${id}`;
      history.replaceState(null, '', `#${id}`);
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      heading.scrollIntoView({
        behavior: prefersReducedMotion ? 'auto' : 'smooth',
        block: 'start',
      });
      if (navigator.clipboard && navigator.clipboard.writeText) {
        void navigator.clipboard.writeText(url);
      }
      const prevTimer = anchorTimers.get(anchor);
      if (prevTimer !== undefined) {
        window.clearTimeout(prevTimer);
      }
      anchor.dataset.copied = 'true';
      anchor.textContent = 'Copied!';
      if (specLiveRegion) {
        specLiveRegion.textContent = `Copied link to section ${id}`;
      }
      const timerId = window.setTimeout(() => {
        anchor.dataset.copied = 'false';
        anchor.textContent = '¶';
        anchorTimers.delete(anchor);
      }, 1400);
      anchorTimers.set(anchor, timerId);
    });
    heading.appendChild(anchor);
  }
</script>
