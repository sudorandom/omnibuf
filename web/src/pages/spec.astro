                </td>
                <td class="whitespace-nowrap font-bold">
                  <span class="px-1.5 py-0.5 bg-ink text-acid rounded">27</span>{' '}
                  <span class="px-1.5 py-0.5 bg-[#E5E0D5] text-ink rounded">11</span>{' '}
                  <span class="px-1.5 py-0.5 bg-acid/40 text-ink rounded">
                    4c 6f 63 61 74 69 6f 6e
                  </span>
                </td>
                <td>
                  <div class="font-bold">
                    SchemaMeta Field #1 (<code>type_name = "Location"</code>)
                  </div>
                  <div class="text-sm text-ink/80">
                    <code>27</code> &rarr; Tag: <code>(1 &lt;&lt; 4) | 3</code> (
                    <code>WireString</code>) &bull; <code>11</code> &rarr; Len: <code>8</code> bytes
