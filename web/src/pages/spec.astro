                <span class="text-ink/60 w-11 shrink-0">0x1E</span>
                <span class="px-1.5 py-0.5 bg-ink text-acid rounded">67</span>
                <span class="px-1.5 py-0.5 bg-[#E5E0D5] border border-ink/30 text-ink rounded">
                  07
                </span>
                <span class="px-1.5 py-0.5 bg-acid/45 border border-ink/30 text-ink rounded">
                  46 52 41
                </span>
