              <tr>
                <th class="w-20">Offset</th>
                <th class="w-44">Hex Bytes</th>
                <th>Field / Region Description</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="whitespace-nowrap font-bold">
                  <code>0x00</code>
                </td>
                <td class="whitespace-nowrap font-bold">
                  <span class="px-1.5 py-0.5 bg-ink text-acid rounded">0b</span>{' '}
                  <span class="px-1.5 py-0.5 bg-[#E5E0D5] text-ink rounded">6e 00</span>
                </td>
                <td>
                  <div class="font-bold">
                    Field #0 Header (<code>SchemaMeta</code>, <code>WireSubMsg = 5</code>)
