---
import { Code } from 'astro:components';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const zigZagGoCode = `// Encode signed int64 -> unsigned uint64:
u := uint64((n << 1) ^ (n >> 63))

// Decode unsigned uint64 -> signed int64:
n := int64(u >> 1) ^ -int64(u & 1)`;

const sec8MetaProtoCode = `syntax = "proto3";
package omnibuf.v1;

// Written at Field #0 (Tag = 0x19, WireSubMsg = 12) when self-describing mode is enabled.
message SchemaMeta {
  string type_name = 1;               // Optional message name (e.g. "Location")
  map<uint32, string> fields = 2;     // FieldNumber -> FieldName (e.g. 3 -> "city")
  map<uint32, SchemaMeta> children = 3; // Parent FieldNumber -> child SchemaMeta (stored once)
}`;

const sec9ProtoCode = `message Location {
  string city = 3; // "FRA"
  uint32 rack = 4; // 42
}

message Node {
  uint32   id       = 1; // 300
  bool     active   = 3; // true
  Location location = 9; // { city: "FRA", rack: 42 }
}`;

const wireTypes = [
  [0, 'WireUint', 'Unsigned Prefix-Varint'],
  [1, 'WireSint', 'ZigZag Prefix-Varint'],
  [2, 'WireBoolFalse', 'No payload (false in the tag)'],
  [3, 'WireBoolTrue', 'No payload (true in the tag)'],
  [4, 'WireFixed32', '4 little-endian unsigned integer bytes'],
  [5, 'WireFixed64', '8 little-endian unsigned integer bytes'],
  [6, 'WireSfixed32', "4 little-endian two's-complement bytes"],
  [7, 'WireSfixed64', "8 little-endian two's-complement bytes"],
  [8, 'WireFloat32', '4 little-endian IEEE-754 bytes'],
  [9, 'WireFloat64', '8 little-endian IEEE-754 bytes'],
  [10, 'WireString', 'ByteLen + UTF-8 bytes'],
  [11, 'WireBytes', 'ByteLen + arbitrary bytes'],
  [12, 'WireSubMsg', 'ByteLen + message fields'],
  [13, 'WireArray', 'ByteLen + ElementType + Count + values'],
  [14, 'WireMap', 'ByteLen + KeyType + ValueType + Count + key/value pairs'],
  [15, 'WireExtended', 'ByteLen + ExtType + extension payload'],
];

const arrayExamples = `// Field #7: array<string> ["a", "bc"]
fb 1e 00 0a 05 03 61 05 62 63
// tag | len=7 | string | count=2 | "a" | "bc"

// Field #8: array<uint> [10, 300]
36 02 16 00 00 05 15 b2 04
// tag   | len=5 | uint | count=2 | 10 | 300

// Field #1: array<bool> [false, true]
3b 12 00 02 05 00 01
// tag | len=4 | bool | count=2 | false | true

// Field #1: empty array<bytes>
3b 0a 00 0b 01
// tag | len=2 | bytes | count=0`;

const nestedArrayExample = `// Field #1: array<array> [[1, 2], [300]]
3b          // field #1, WireArray
32 00       // outer ByteLen = 12
0d 05       // ElementType = WireArray, Count = 2
09 00 05 03 05 // inner ByteLen=4, uint, Count=2, 1, 2
09 00 03 b2 04 // inner ByteLen=4, uint, Count=1, 300`;

const mapExample = `// Field #2: map<string, uint> {"a": 7, "b": 300}
5d 2a 00 0a 00 05 03 61 0f 03 62 b2 04
// tag | len=10 | key=string | val=uint | count=2 | "a":7 | "b":300`;

const fixedExamples = `// Field #1: fixed32 integer 42
29 2a 00 00 00

// Field #1: sfixed32 integer -42
2d d6 ff ff ff

// Field #1: float32 number 42.0
31 00 00 28 42`;

const nodeExample = `21 b2 04                  // #1 uint: id = 300
67                        // #3 bool: active = true
72 02 1e 00               // #9 message: location, ByteLen = 7
  75 07 46 52 41          // #3 string: city = "FRA"
  81 55                   // #4 uint: rack = 42`;

const sectionTitles = [
  'Design Goals & Overview',
  'Message Layout & Concatenation',
  'Prefix-Varint Encoding',
  'Signed Integers',
  'Field Tags & Value Types',
  'Wire Type Specifications',
  'Field Lookup & Validation',
  'Optional Naming Metadata',
  'Complete Message Example',
  'Validity & Rejection Rules',
  'Schema Mapping & Conformance',
];
const subsectionTitles: Record<number, string[]> = {
  1: ['Design Goals', 'Core Wire Primitives'],
  3: ['Bit-Level Layout', 'Examples & Size Tradeoffs', 'Non-Minimal Encodings & Backpatching'],
  4: ['ZigZag Mapping', 'Examples'],
  5: ['Tag Width'],
  6: [
    'WireUint (0)',
    'WireSint (1)',
    'WireBoolFalse (2)',
    'WireBoolTrue (3)',
    'WireFixed32 (4)',
    'WireFixed64 (5)',
    'WireSfixed32 (6)',
    'WireSfixed64 (7)',
    'WireFloat32 (8)',
    'WireFloat64 (9)',
    'WireString (10)',
    'WireBytes (11)',
    'WireSubMsg (12)',
    'WireArray (13)',
    'WireMap (14)',
    'WireExtended (15)',
  ],
  8: [
    'SchemaMeta Definition',
    'Placement & Interpretation',
    'Names for Collection Contents',
    'Metadata Merge',
  ],
  11: ['Schema Mapping', 'Conformance Requirements'],
};
const tocSections = sectionTitles.map((title, index) => ({
  id: `sec-${index + 1}`,
  label: `${index + 1}. ${title}`,
  children: (subsectionTitles[index + 1] ?? []).map((subtitle, childIndex) => ({
    id: `sec-${index + 1}-${childIndex + 1}`,
    label: `${index + 1}.${childIndex + 1} ${subtitle}`,
  })),
}));
---

<Layout
  title="Wire Format Specification | OmniBuf"
  description="OmniBuf wire-format draft: precise scalar types, composable arrays and maps, prefix-varints, recursive merge rules, validation, and annotated byte examples."
>
  <Navbar currentPage="spec" />

  <main id="main-content" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <!-- Spec Header -->
    <div class="mb-12">
      <h1 class="text-[2.6rem] sm:text-7xl lg:text-[5.5rem] font-bold tracking-tight uppercase leading-[0.94] text-ink">
        Wire Format
        <br />
        <span class="font-serif italic font-normal normal-case text-[#FF4F18] text-[3.1rem] sm:text-8xl lg:text-[6.2rem]">
          Specification.
        </span>
      </h1>
      <p class="mt-6 max-w-3xl text-lg sm:text-2xl text-ink/85 font-medium leading-snug">
        Current unreleased wire-format draft: precise value types and composable arrays and maps.
      </p>
    </div>

    <!-- Sticky Mobile Section Jump Bar (< lg viewports) -->
    <div class="lg:hidden sticky top-14 z-30 mb-6 flex items-start gap-2 font-mono text-sm no-print">
      <details id="mobile-spec-toc" class="flex-1 os-window bg-[#FAF8F2]">
        <summary class="px-4 py-2.5 font-bold uppercase cursor-pointer focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink">
          <span id="mobile-spec-toc-label">Jump to Spec Section</span>
        </summary>
        <nav
          aria-label="Mobile specification sections"
          class="p-3 border-t-2 border-ink space-y-1 max-h-64 overflow-y-auto"
        >
          {tocSections.map((sec) => (
            <div>
              <a
                href={`#${sec.id}`}
                data-mobile-spec-link={sec.id}
                data-active="false"
                class="block px-2.5 py-1.5 rounded font-bold hover:bg-ink/5 data-[active=true]:bg-acid data-[active=true]:text-ink"
              >
                {sec.label}
              </a>
              {sec.children.length > 0 && (
                <div class="pl-3 ml-2.5 mt-0.5 mb-1 space-y-0.5 border-l-2 border-ink/25">
                  {sec.children.map((sub) => (
                    <a
                      href={`#${sub.id}`}
                      data-mobile-spec-link={sub.id}
                      data-active="false"
                      class="block px-2 py-1 rounded text-xs text-ink/80 hover:text-ink hover:bg-ink/5 data-[active=true]:bg-acid/40 data-[active=true]:text-ink data-[active=true]:font-bold"
                    >
                      {sub.label}
                    </a>
                  ))}
                </div>
              )}
            </div>
          ))}
        </nav>
      </details>
      <a
        href="#main-content"
        class="os-btn px-3 py-2.5 bg-[#FAF8F2] text-ink font-bold rounded-md shrink-0"
      >
        Top &uarr;
      </a>
    </div>

    <div class="grid lg:grid-cols-12 gap-8 items-start">
      <!-- Left Sticky Table of Contents -->
      <aside class="hidden lg:block lg:col-span-3 lg:sticky lg:top-16 no-print">
        <div class="os-window bg-[#FAF8F2] p-4 lg:max-h-[calc(100vh-5.5rem)] lg:overflow-y-auto">
          <div class="font-mono text-sm font-bold uppercase pb-2.5 mb-2.5 border-b-2 border-ink flex items-center justify-between gap-2">
            <span>Contents</span>
            <a
              href="#main-content"
              class="text-xs px-2 py-0.5 bg-white border border-ink rounded hover:bg-acid transition shrink-0 whitespace-nowrap"
            >
              Top &uarr;
            </a>
          </div>
          <nav aria-label="Specification sections" class="space-y-1 font-mono text-sm">
            {tocSections.map((sec) => (
              <div>
                <a
                  href={`#${sec.id}`}
                  data-spec-link={sec.id}
                  data-active="false"
                  class="block px-2.5 py-1.5 rounded border border-transparent hover:bg-ink/5 transition data-[active=true]:bg-acid data-[active=true]:border-ink data-[active=true]:font-bold"
                >
                  {sec.label}
                </a>
                {sec.children.length > 0 && (
                  <div
                    data-subtoc={sec.id}
                    class:list={[
                      'pl-3 ml-2.5 mt-1 mb-1.5 space-y-1 border-l-2 border-ink/25',
                      sec.id === 'sec-6' ? 'block' : 'hidden',
                    ]}
                  >
                    {sec.children.map((sub) => (
                      <a
                        href={`#${sub.id}`}
                        data-spec-h3={sub.id}
                        data-active="false"
                        class="block px-2 py-1 rounded text-xs sm:text-sm text-ink/80 hover:text-ink hover:bg-ink/5 transition data-[active=true]:text-ink data-[active=true]:font-bold data-[active=true]:bg-acid/40"
                      >
                        {sub.label}
                      </a>
                    ))}
                  </div>
                )}
              </div>
            ))}
          </nav>
        </div>
      </aside>

      <!-- Main Specification Document Sheet -->
      <article class="lg:col-span-9 min-w-0 os-window-lg bg-[#FAF8F2] p-6 sm:p-10 lg:p-12 spec-prose">
        <h2 id="sec-1">1. Design Goals &amp; Overview</h2>
        <h3 id="sec-1-1">1.1 Design Goals</h3>
        <p>
          OmniBuf is a binary encoding for numbered fields. This document describes the current,
          unreleased design and replaces the earlier draft. There are no legacy array encodings or
          compatibility modes in this specification. MUST, SHOULD, and MAY describe requirements for
          implementations of this draft, not a claim that every implementation already meets them.
        </p>
        <ul>
          <li>Keep explicit field numbers and support existing protobuf schema concepts.</li>
          <li>
            Make values interpretable without an external schema by distinguishing strings from
            bytes, signed from unsigned integers, and floating-point from fixed-width integer
            values.
          </li>
          <li>
            Compose collections from the same value types using one array type plus an element type,
            and one map type plus key and value types.
          </li>
          <li>
            Use a flat field stream with length-prefixed containers, forward encoding, and defined
            concatenation semantics.
          </li>
        </ul>
        <h3 id="sec-1-2">1.2 Core Wire Primitives</h3>
        <p>
          Each field is <code>[Tag][Value]</code>. Tags, unsigned variable-width integers, byte
          lengths, and collection counts use Prefix-Varints. A tag combines a field number with a
          four-bit wire type. Every variable-length value begins with its byte length. All
          multi-byte fixed-width values are little-endian.
        </p>
        <p>
          Wire types identify the encoded value, not every detail of a source schema. For example, a
          signed enum number and an ordinary signed integer share an encoding. Field names, enum
          labels, declared integer ranges, defaults, and oneof membership cannot all be inferred
          from the value bytes. Optional Field #0 supplies message and field names.
        </p>

        <h2 id="sec-2">2. Message Layout &amp; Concatenation</h2>
        <pre><code>[Tag][Value] [Tag][Value] ... [Tag][Value]</code></pre>
        <p>
          A root message has no mandatory header, footer, alignment padding, or length prefix. Its
          containing file or transport MUST provide its byte boundary. An empty message is zero
          bytes. Concatenation merges messages rather than framing separate messages.
        </p>
        <p>
          Encoders SHOULD emit fields in ascending field-number order. Decoders MUST accept any
          order and repeated occurrences of a field. For compatible schemas, concatenating two
          packets has these semantics:
        </p>
        <ul>
          <li>For singular scalars, the last occurrence wins.</li>
          <li>
            For arrays, elements concatenate in occurrence order. Empty arrays add no elements and
            do not clear an earlier array.
          </li>
          <li>For messages, fields merge recursively, including nested arrays and maps.</li>
          <li>
            For maps, entries merge in order and the last entry for a key replaces its entire value,
            including when that value is a message, array, or map.
          </li>
        </ul>
        <p>
          A schema-aware decoder also applies presence and oneof rules from its schema. A blind
          decoder cannot infer oneof membership. Concatenation does not provide a delete operation.
          Changing a field's value type or an array's element type is not a compatible schema
          change.
        </p>

        <h2 id="sec-3">3. Prefix-Varint Encoding</h2>
        <h3 id="sec-3-1">3.1 Bit-Level Layout</h3>
        <p>
          The first byte determines the encoded width. An implementation can dispatch with bit tests
          or a trailing-zero-count instruction, and the format does not require a particular
          instruction or a branchless implementation.
        </p>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>First byte</th>
                <th>Total width</th>
                <th>Value capacity</th>
                <th>Encoding</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>
                  <code>xxxxxxx1</code>
                </td>
                <td>1 byte</td>
                <td>7 bits</td>
                <td>
                  <code>(v &lt;&lt; 1) | 1</code>
                </td>
              </tr>
              <tr>
                <td>
                  <code>xxxxxx10</code>
                </td>
                <td>2 bytes</td>
                <td>14 bits</td>
                <td>
                  <code>LE16((v &lt;&lt; 2) | 2)</code>
                </td>
              </tr>
              <tr>
                <td>
                  <code>xxxxx100</code>
                </td>
                <td>4 bytes</td>
                <td>29 bits</td>
                <td>
                  <code>LE32((v &lt;&lt; 3) | 4)</code>
                </td>
              </tr>
              <tr>
                <td>
                  <code>00000000</code>
                </td>
                <td>9 bytes</td>
                <td>64 bits</td>
                <td>
                  <code>00 + LE64(v)</code>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
        <p>
          Decode the first three forms by loading the indicated little-endian word and shifting
          right by 1, 2, or 3 bits. The nine-byte form stores its value in bytes 1 through 8. Other
          first-byte patterns with their low three bits zero are reserved and MUST be rejected. A
          decoder MUST check the available width before loading.
        </p>
        <h3 id="sec-3-2">3.2 Examples &amp; Size Tradeoffs</h3>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Unsigned value</th>
                <th>OmniBuf hex</th>
                <th>OmniBuf bytes</th>
                <th>LEB128 bytes</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>0</td>
                <td>
                  <code>01</code>
                </td>
                <td>1</td>
                <td>1</td>
              </tr>
              <tr>
                <td>127</td>
                <td>
                  <code>ff</code>
                </td>
                <td>1</td>
                <td>1</td>
              </tr>
              <tr>
                <td>128</td>
                <td>
                  <code>02 02</code>
                </td>
                <td>2</td>
                <td>2</td>
              </tr>
              <tr>
                <td>300</td>
                <td>
                  <code>b2 04</code>
                </td>
                <td>2</td>
                <td>2</td>
              </tr>
              <tr>
                <td>16,384</td>
                <td>
                  <code>04 00 02 00</code>
                </td>
                <td>4</td>
                <td>3</td>
              </tr>
              <tr>
                <td>536,870,912</td>
                <td>
                  <code>00 00 00 00 20 00 00 00 00</code>
                </td>
                <td>9</td>
                <td>5</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p>
          The missing three-, five-, six-, seven-, and eight-byte forms simplify dispatch but can
          increase payload size. Values at or above 2<sup>29</sup> use nine bytes. Payload-size and
          speed comparisons therefore depend on the workload and implementation.
        </p>
        <h3 id="sec-3-3">3.3 Non-Minimal Encodings &amp; Backpatching</h3>
        <p>
          Decoders MUST accept a value in any of these four widths that can represent it, even when
          a shorter encoding exists. Encoders SHOULD use the shortest width except when reserving a
          wider slot for backpatching. For example, 42 can be <code>55</code> or
          <code>aa 00</code>.
        </p>
        <p>
          A forward encoder can reserve two bytes for a container length, write its contents, and
          patch <code>LE16((byteLen &lt;&lt; 2) | 2)</code>. This slot holds up to 16,383 bytes.
          Larger bodies require expanding the slot to four or nine bytes, moving the already written
          body unless the encoder chose another buffering strategy. Nested large containers may move
          the same bytes more than once. Counts may also use reserved slots.
        </p>
        <p>
          This flexibility means the wire format is not canonical. Sorted fields alone do not
          produce a unique encoding because map order, duplicate fields, and integer widths also
          matter.
        </p>

        <h2 id="sec-4">4. Signed Integers</h2>
        <h3 id="sec-4-1">4.1 ZigZag Mapping</h3>
        <p>
          <code>WireSint</code> stores a ZigZag-mapped signed integer as a Prefix-Varint. Protobuf
          <code>int32</code>, <code>int64</code>, <code>sint32</code>, <code>sint64</code>, and enum
          numbers use this type. Negative enum values retain their sign.
        </p>
        <Code code={zigZagGoCode} lang="go" />
        <h3 id="sec-4-2">4.2 Examples</h3>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Signed value</th>
                <th>ZigZag value</th>
                <th>Hex</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>0</td>
                <td>0</td>
                <td>
                  <code>01</code>
                </td>
              </tr>
              <tr>
                <td>-1</td>
                <td>1</td>
                <td>
                  <code>03</code>
                </td>
              </tr>
              <tr>
                <td>1</td>
                <td>2</td>
                <td>
                  <code>05</code>
                </td>
              </tr>
              <tr>
                <td>-64</td>
                <td>127</td>
                <td>
                  <code>ff</code>
                </td>
              </tr>
              <tr>
                <td>64</td>
                <td>128</td>
                <td>
                  <code>02 02</code>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
        <p>
          Signed fixed-width integers use <code>WireSfixed32</code> or <code>WireSfixed64</code>
          and two's-complement bits, without ZigZag.
        </p>

        <h2 id="sec-5">5. Field Tags &amp; Value Types</h2>
        <pre><code>Tag = (FieldNumber &lt;&lt; 4) | WireType</code></pre>
        <p>
          Encode Tag as a Prefix-Varint. Field numbers range from 1 through 536,870,911, while Field
          #0 is reserved for naming metadata. Protobuf-backed schemas retain protobuf's
          reserved-field-number rules. Implementations MUST reject out-of-range tags before
          narrowing them to a language integer type.
        </p>
        <h3 id="sec-5-1">5.1 Tag Width</h3>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Field numbers</th>
                <th>Minimum tag width</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>0 to 7</td>
                <td>1 byte</td>
              </tr>
              <tr>
                <td>8 to 1,023</td>
                <td>2 bytes</td>
              </tr>
              <tr>
                <td>1,024 to 33,554,431</td>
                <td>4 bytes</td>
              </tr>
              <tr>
                <td>33,554,432 to 536,870,911</td>
                <td>9 bytes</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p>
          The same type codes identify array elements and map keys and values. Collection values
          omit field tags. Variable-length collection values still include their own byte-length
          prefix. Boolean values are the only contextual exception, described below.
        </p>

        <h2 id="sec-6">6. Wire Type Specifications</h2>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Code</th>
                <th>Type</th>
                <th>Field payload</th>
              </tr>
            </thead>
            <tbody>
              {wireTypes.map(([code, name, payload]) => (
                <tr>
                  <td>{code}</td>
                  <td>
                    <code>{name}</code>
                  </td>
                  <td>{payload}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <h3 id="sec-6-1">6.1 WireUint (0)</h3>
        <pre><code>[Value: Prefix-Varint]</code></pre>
        <p>
          <code>WireUint = 0</code> contains one unsigned Prefix-Varint up to 64 bits wide. It uses
          this same encoding as a field payload, an array element, and a map key or value.
        </p>

        <h3 id="sec-6-2">6.2 WireSint (1)</h3>
        <pre><code>[ZigZag Value: Prefix-Varint]</code></pre>
        <p>
          <code>WireSint = 1</code> contains one ZigZag-encoded signed integer stored as a
          Prefix-Varint. It uses this same encoding as a field payload, an array element, and a map
          key or value.
        </p>

        <h3 id="sec-6-3">6.3 WireBoolFalse (2)</h3>
        <p>
          A field tag with <code>WireBoolFalse = 2</code> encodes the boolean value{' '}
          <code>false</code> in the tag itself and carries zero payload bytes.
        </p>
        <p>
          Inside an array or map header, type code <code>2</code> represents the boolean element or
          entry type. Each boolean inside a collection is encoded as a single raw byte:
          <code>00</code> for false or <code>01</code> for true. Collection boolean bytes are raw
          bytes rather than Prefix-Varints, and any value other than <code>00</code> or{' '}
          <code>01</code> is invalid.
        </p>

        <h3 id="sec-6-4">6.4 WireBoolTrue (3)</h3>
        <p>
          A field tag with <code>WireBoolTrue = 3</code> encodes the boolean value <code>true</code>{' '}
          in the tag itself and carries zero payload bytes.
        </p>
        <p>
          Type code <code>3</code> is only valid as a field tag wire type. It MUST NOT appear as an{' '}
          <code>ElementType</code> in an array or as a <code>KeyType</code> or{' '}
          <code>ValueType</code> in a map. Collections always declare boolean elements or entries
          using code <code>2</code>.
        </p>

        <h3 id="sec-6-5">6.5 WireFixed32 (4)</h3>
        <pre><code>[4 bytes: uint32, little-endian]</code></pre>
        <p>
          <code>WireFixed32 = 4</code> contains a four-byte unsigned integer in little-endian byte
          order. Because it is distinct from <code>WireSfixed32 = 6</code> and{' '}
          <code>WireFloat32 = 8</code>, decoders never confuse 32-bit unsigned integers with signed
          values or floating-point numbers.
        </p>

        <h3 id="sec-6-6">6.6 WireFixed64 (5)</h3>
        <pre><code>[8 bytes: uint64, little-endian]</code></pre>
        <p>
          <code>WireFixed64 = 5</code> contains an eight-byte unsigned integer in little-endian byte
          order. It remains distinct from <code>WireSfixed64 = 7</code> and{' '}
          <code>WireFloat64 = 9</code> in fields, arrays, and maps.
        </p>

        <h3 id="sec-6-7">6.7 WireSfixed32 (6)</h3>
        <pre><code>[4 bytes: int32, two's-complement little-endian]</code></pre>
        <p>
          <code>WireSfixed32 = 6</code> contains a four-byte signed two's-complement integer in
          little-endian byte order. It uses code <code>6</code> as a field value, an array element,
          and a map key or value.
        </p>
        <Code code={fixedExamples} lang="text" />

        <h3 id="sec-6-8">6.8 WireSfixed64 (7)</h3>
        <pre><code>[8 bytes: int64, two's-complement little-endian]</code></pre>
        <p>
          <code>WireSfixed64 = 7</code> contains an eight-byte signed two's-complement integer in
          little-endian byte order. It uses code <code>7</code> as a field value, an array element,
          and a map key or value.
        </p>

        <h3 id="sec-6-9">6.9 WireFloat32 (8)</h3>
        <pre><code>[4 bytes: IEEE-754 binary32, little-endian]</code></pre>
        <p>
          <code>WireFloat32 = 8</code> contains four little-endian IEEE-754 binary32 bytes. Signed
          zero, infinities, and NaN bit patterns are valid on the wire. In arrays and maps, each{' '}
          <code>WireFloat32</code> value occupies four consecutive bytes.
        </p>

        <h3 id="sec-6-10">6.10 WireFloat64 (9)</h3>
        <pre><code>[8 bytes: IEEE-754 binary64, little-endian]</code></pre>
        <p>
          <code>WireFloat64 = 9</code> contains eight little-endian IEEE-754 binary64 bytes. Signed
          zero, infinities, and NaN bit patterns are valid on the wire. In arrays and maps, each{' '}
          <code>WireFloat64</code> value occupies eight consecutive bytes.
        </p>

        <h3 id="sec-6-11">6.11 WireString (10)</h3>
        <pre><code>[ByteLen: Prefix-Varint][UTF-8 bytes]</code></pre>
        <p>
          <code>WireString = 10</code> contains a byte-length prefix followed by valid UTF-8 text
          without a null terminator. It uses this same length-prefixed encoding as a field value, an
          array element, and a map key or value.
        </p>

        <h3 id="sec-6-12">6.12 WireBytes (11)</h3>
        <pre><code>[ByteLen: Prefix-Varint][Raw bytes]</code></pre>
        <p>
          <code>WireBytes = 11</code> contains a byte-length prefix followed by arbitrary raw bytes.
          Because it has a dedicated type code distinct from <code>WireString = 10</code> in fields,
          arrays, and maps, binary payloads never have to masquerade as UTF-8 text.
        </p>

        <h3 id="sec-6-13">6.13 WireSubMsg (12)</h3>
        <pre><code>[ByteLen: Prefix-Varint][Message field stream]</code></pre>
        <p>
          <code>WireSubMsg = 12</code> contains a byte-length prefix followed by a nested message
          field stream. Its fields obey the same rules as root fields. A zero-length payload
          represents a present, empty message. Array elements and map values of message type use
          this same length-prefixed encoding.
        </p>

        <h3 id="sec-6-14">6.14 WireArray (13)</h3>
        <pre><code>[Tag: WireArray]
[ByteLen: Prefix-Varint][ElementType: 1 byte][Count: Prefix-Varint][Element_0]…[Element_N-1]
                       |&lt;------------------- ByteLen bytes -----------------------------&gt;|</code></pre>
        <p>
          Every array uses <code>WireArray = 13</code>. Its element type appears once before the
          element count. All elements use that type's value encoding without per-element field tags.
          ByteLen covers <code>ElementType</code>, <code>Count</code>, and all encoded elements,
          while excluding its own prefix and the outer field tag.
        </p>
        <ul>
          <li>
            ElementType is a single byte containing a wire type code from the table. Its high four
            bits MUST be zero. Code 3 is invalid here, so boolean arrays use code 2.
          </li>
          <li>
            Count is required for every element type, including messages and fixed-width values.
            Count zero is valid and still requires an element type byte.
          </li>
          <li>Strings, bytes, and messages retain an individual byte-length prefix per element.</li>
          <li>Fixed-width values are packed consecutively without alignment padding.</li>
          <li>Decoders MUST consume exactly Count elements and exactly ByteLen bytes.</li>
        </ul>
        <Code code={arrayExamples} lang="text" />
        <p>
          Arrays and maps can also nest inside an array. An array of arrays uses{' '}
          <code>ElementType = 13</code>, where each inner array carries its own ByteLen,
          ElementType, Count, and elements. An array of maps uses <code>ElementType = 14</code>,
          where each inner map carries its own ByteLen, KeyType, ValueType, Count, and entries.
        </p>
        <Code code={nestedArrayExample} lang="text" />

        <h3 id="sec-6-15">6.15 WireMap (14)</h3>
        <pre><code>[Tag: WireMap]
[ByteLen: Prefix-Varint][KeyType: 1 byte][ValueType: 1 byte][Count: Prefix-Varint][Key_0][Value_0]…
                       |&lt;----------------------- ByteLen bytes ------------------------&gt;|</code></pre>
        <p>
          Every map uses <code>WireMap = 14</code>. Two type bytes (<code>KeyType</code> followed by{' '}
          <code>ValueType</code>) declare its key and value types once using the same 1-byte codes
          as fields and array elements (with the high four bits of each byte set to zero). Entries
          omit field tags and synthetic entry-message wrappers. Each entry contains one key
          immediately followed by one value. ByteLen covers <code>KeyType</code>,{' '}
          <code>ValueType</code>, <code>Count</code>, and all encoded entries.
        </p>
        <ul>
          <li>
            KeyType MUST be unsigned integer (0), signed integer (1), boolean (2), unsigned fixed32
            (4), unsigned fixed64 (5), signed fixed32 (6), signed fixed64 (7), or string (10).
          </li>
          <li>
            ValueType may be any value type except code 3. Nested arrays (13) and maps (14) are
            encoded recursively using their own length-prefixed headers.
          </li>
          <li>
            Count is the number of encoded entries, including duplicate keys. Zero entries are
            valid.
          </li>
          <li>
            Duplicate keys use last-entry-wins semantics. Repeated map fields merge entries.
            Duplicate message-valued entries replace the earlier message rather than merging it.
          </li>
          <li>
            Map entries may appear in any order. Deterministic encoders SHOULD sort keys by value.
          </li>
        </ul>
        <Code code={mapExample} lang="text" />

        <h3 id="sec-6-16">6.16 WireExtended (15)</h3>
        <pre><code>[ByteLen: Prefix-Varint][ExtType: 1 byte][Extension payload]</code></pre>
        <p>
          <code>WireExtended = 15</code> reserves an escape hatch for future value types. ByteLen
          MUST be at least one and includes <code>ExtType</code>. This draft assigns no extension
          subtypes. Unknown extensions remain skippable by their outer byte length. A reader asked
          to interpret an unknown extension MUST return an unsupported-type error rather than guess
          its meaning. Each extension value in an array or map includes its own length and subtype.
        </p>

        <h2 id="sec-7">7. Field Lookup &amp; Validation</h2>
        <p>
          A field scanner reads a tag, determines its scalar width or container byte length, and
          advances to the next field. Skipping a container does not require visiting its elements.
          Locating a field is linear in the number of field headers examined, with constant-time
          skipping per field rather than constant-time random access.
        </p>
        <p>
          Lookup APIs MUST state whether they return the last occurrence, all occurrences, or a
          merged value. Returning only the last message or array occurrence does not implement
          recursive message merge or array concatenation.
        </p>
        <p>
          Bounds-checked skipping and full validation are distinct operations. A scanner MAY skip a
          bounded container without validating its contents. A full validating decoder MUST validate
          all core-type contents, even in unknown fields. APIs that skip unknown contents MUST
          document that they do not perform full packet validation.
        </p>

        <h2 id="sec-8">8. Optional Naming Metadata (Field #0)</h2>
        <h3 id="sec-8-1">8.1 SchemaMeta Definition</h3>
        <p>
          Field #0 MUST be a WireSubMsg containing this message, encoded using OmniBuf rather than
          protobuf wire bytes. Names are optional because scalar and collection types are already
          carried by their value encodings. No logical-type correction table is needed.
        </p>
        <Code code={sec8MetaProtoCode} lang="proto" />
        <h3 id="sec-8-2">8.2 Placement &amp; Interpretation</h3>
        <p>
          Encoders SHOULD put Field #0 first. Decoders MUST accept it anywhere, including multiple
          occurrences after concatenation. Metadata applies by numeric field ID, not by the position
          of a field in a packet. A blind reader SHOULD resolve the merged metadata before assigning
          output names, so late metadata does not create duplicate output keys for one field.
        </p>
        <p>
          Without names, a blind reader can use keys such as <code>field_1</code>. Metadata does not
          reconstruct omitted values, enum labels, oneof membership, or application-specific
          meaning. Names are presentation metadata and MUST NOT change which numeric fields merge. A
          reader MUST avoid silently overwriting distinct fields when their supplied names collide.
        </p>
        <h3 id="sec-8-3">8.3 Names for Collection Contents</h3>
        <p>
          The <code>children</code> map stores the naming metadata for a field's message values
          once. For arrays and map values, that metadata is inherited through nested collections
          until a message value is reached. It is not repeated for every element. An element's own
          Field #0 may refine its inherited names. If collection contents have different message
          schemas, they can carry their own naming metadata.
        </p>
        <h3 id="sec-8-4">8.4 Metadata Merge</h3>
        <p>
          Later nonempty type names and later field-name entries override earlier ones. Child
          metadata for the same numeric field merges recursively. This recursive merge of
          <code>children</code> is a SchemaMeta-specific rule, while ordinary map entries still
          replace their entire values. Field #0 MUST be structurally valid, even when a decoder
          already has an external schema.
        </p>

        <h2 id="sec-9">9. Complete Message Example</h2>
        <Code code={sec9ProtoCode} lang="proto" />
        <Code code={nodeExample} lang="text" />
        <p>
          The seven-byte Location body has a two-byte reserved length prefix. The root message
          occupies 15 bytes. A reader can skip Location directly from its length, or decode its
          fields without knowing the schema, and Field #0 can add field names to that inspection.
        </p>

        <h2 id="sec-10">10. Validity &amp; Rejection Rules</h2>
        <ul>
          <li>
            Reject truncated tags, scalar payloads, and length or count prefixes, invalid prefix
            patterns, and field numbers outside the defined range. Check lengths before converting
            to a platform-sized integer or adding them to an offset.
          </li>
          <li>
            For every length-prefixed value, require
            <code>byteLen &lt;= remainingBytes</code> after consuming the length prefix. Nested
            values MUST stay within their own enclosing container, not merely the root packet.
          </li>
          <li>
            An array body MUST contain ElementType and Count. Validate its type even when Count is
            zero. Reject invalid element codes, invalid boolean bytes, mismatched counts, and
            trailing bytes. For fixed-width elements require
            <code>count == remainingBytes / width</code> and
            <code>remainingBytes % width == 0</code>.
          </li>
          <li>
            Before allocating variable-width array elements, require
            <code>count &lt;= remainingBytes</code>. Every value encoding consumes at least one
            byte. Then parse exactly Count elements and require an exact end boundary.
          </li>
          <li>
            A map body MUST contain KeyType, ValueType, and Count. Validate both type bytes even
            when empty. Before allocating entries, require{' '}
            <code>count &lt;= remainingBytes / 2</code>. Use division rather than multiplying an
            attacker-controlled count, which can overflow. Parse exactly Count entries and require
            an exact end boundary.
          </li>
          <li>Strings MUST contain valid UTF-8. Arbitrary binary data MUST use WireBytes.</li>
          <li>
            Field #0 MUST use WireSubMsg and contain valid SchemaMeta. Its fields map uses
            <code>KeyType = 0x00, ValueType = 0x0A</code> and its children map uses{' '}
            <code>KeyType = 0x00, ValueType = 0x0C</code>.
          </li>
          <li>
            Decoders MUST enforce a nesting limit. The default is 32 nested containers below the
            root, counting messages, arrays, and maps, including nested collections. Metadata
            parsing MUST also have a bounded recursion limit.
          </li>
          <li>
            Implementations SHOULD provide message-size and allocation limits. A valid uint64 length
            is not authorization to allocate that much memory.
          </li>
        </ul>
        <p>
          Unknown field numbers do not make a packet invalid. Unknown core fields can be inspected
          or skipped using their wire types. Unknown extensions can be skipped by length, but cannot
          be interpreted without their extension definition. Implementations MUST document whether
          unknown fields survive decode and re-encode.
        </p>

        <h2 id="sec-11">11. Schema Mapping &amp; Conformance</h2>
        <h3 id="sec-11-1">11.1 Schema Mapping</h3>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Protobuf schema kind</th>
                <th>OmniBuf wire type</th>
                <th>Collection &amp; value notes</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>
                  <code>uint32</code>
                </td>
                <td>
                  <code>WireUint (0)</code>
                </td>
                <td>Unsigned Prefix-Varint (must fit in 32 bits)</td>
              </tr>
              <tr>
                <td>
                  <code>uint64</code>
                </td>
                <td>
                  <code>WireUint (0)</code>
                </td>
                <td>Unsigned Prefix-Varint (up to 64 bits)</td>
              </tr>
              <tr>
                <td>
                  <code>int32</code>
                </td>
                <td>
                  <code>WireSint (1)</code>
                </td>
                <td>ZigZag Prefix-Varint (must fit in signed 32 bits)</td>
              </tr>
              <tr>
                <td>
                  <code>int64</code>
                </td>
                <td>
                  <code>WireSint (1)</code>
                </td>
                <td>ZigZag Prefix-Varint (up to signed 64 bits)</td>
              </tr>
              <tr>
                <td>
                  <code>sint32</code>
                </td>
                <td>
                  <code>WireSint (1)</code>
                </td>
                <td>ZigZag Prefix-Varint (must fit in signed 32 bits)</td>
              </tr>
              <tr>
                <td>
                  <code>sint64</code>
                </td>
                <td>
                  <code>WireSint (1)</code>
                </td>
                <td>ZigZag Prefix-Varint (up to signed 64 bits)</td>
              </tr>
              <tr>
                <td>
                  <code>enum</code>
                </td>
                <td>
                  <code>WireSint (1)</code>
                </td>
                <td>ZigZag Prefix-Varint (signed 32-bit enum number)</td>
              </tr>
              <tr>
                <td>
                  <code>bool</code>
                </td>
                <td>
                  <code>WireBoolFalse (2)</code> / <code>WireBoolTrue (3)</code>
                </td>
                <td>
                  Zero payload bytes in field tags, or type code <code>2</code> with 1 raw byte (
                  <code>00</code> or <code>01</code>) in arrays and maps
                </td>
              </tr>
              <tr>
                <td>
                  <code>fixed32</code>
                </td>
                <td>
                  <code>WireFixed32 (4)</code>
                </td>
                <td>4-byte little-endian unsigned integer</td>
              </tr>
              <tr>
                <td>
                  <code>fixed64</code>
                </td>
                <td>
                  <code>WireFixed64 (5)</code>
                </td>
                <td>8-byte little-endian unsigned integer</td>
              </tr>
              <tr>
                <td>
                  <code>sfixed32</code>
                </td>
                <td>
                  <code>WireSfixed32 (6)</code>
                </td>
                <td>4-byte little-endian two's-complement signed integer</td>
              </tr>
              <tr>
                <td>
                  <code>sfixed64</code>
                </td>
                <td>
                  <code>WireSfixed64 (7)</code>
                </td>
                <td>8-byte little-endian two's-complement signed integer</td>
              </tr>
              <tr>
                <td>
                  <code>float</code>
                </td>
                <td>
                  <code>WireFloat32 (8)</code>
                </td>
                <td>4-byte little-endian IEEE-754 binary32 float</td>
              </tr>
              <tr>
                <td>
                  <code>double</code>
                </td>
                <td>
                  <code>WireFloat64 (9)</code>
                </td>
                <td>8-byte little-endian IEEE-754 binary64 float</td>
              </tr>
              <tr>
                <td>
                  <code>string</code>
                </td>
                <td>
                  <code>WireString (10)</code>
                </td>
                <td>ByteLen Prefix-Varint followed by valid UTF-8 bytes</td>
              </tr>
              <tr>
                <td>
                  <code>bytes</code>
                </td>
                <td>
                  <code>WireBytes (11)</code>
                </td>
                <td>ByteLen Prefix-Varint followed by raw bytes</td>
              </tr>
              <tr>
                <td>
                  <code>message</code>
                </td>
                <td>
                  <code>WireSubMsg (12)</code>
                </td>
                <td>ByteLen Prefix-Varint followed by nested field stream</td>
              </tr>
              <tr>
                <td>
                  <code>repeated T</code>
                </td>
                <td>
                  <code>WireArray (13)</code>
                </td>
                <td>
                  ByteLen + <code>ElementType</code> (T's wire type code, using <code>2</code> for
                  bool) + <code>Count</code> + elements
                </td>
              </tr>
              <tr>
                <td>
                  <code>map&lt;K, V&gt;</code>
                </td>
                <td>
                  <code>WireMap (14)</code>
                </td>
                <td>
                  ByteLen + <code>KeyType</code> (1 byte) + <code>ValueType</code> (1 byte) +{' '}
                  <code>Count</code> + key/value pairs
                </td>
              </tr>
            </tbody>
          </table>
        </div>
        <p>
          Implementations MUST preserve explicit presence and active oneof members, including
          present zero values. Unsupported schema features MUST produce a clear error rather than
          silently dropping data. Using protobuf schemas does not make OmniBuf bytes protobuf-wire
          compatible. Language libraries and generators MUST document their supported schema subset.
        </p>
        <h3 id="sec-11-2">11.2 Conformance Requirements</h3>
        <p>
          Each implementation should exercise independent wire fixtures and cross-path round trips
          for the current draft. Generated codecs, descriptor-based codecs, plain-struct codecs, and
          blind readers MUST agree on value encodings wherever their supported features overlap.
          Tests MUST cover:
        </p>
        <ul>
          <li>Every scalar type, prefix width, non-minimal prefix, and field-number boundary.</li>
          <li>
            Every valid array element type, empty arrays, arrays of arrays, arrays of maps, and maps
            containing arrays or maps.
          </li>
          <li>Distinct string/bytes and float/fixed/sfixed interpretations without Field #0.</li>
          <li>
            Recursive message merges, nested repeated fields, duplicate map keys, late metadata, and
            present oneof zero values.
          </li>
          <li>
            Counts near integer limits, mismatched byte lengths, malformed empty collections,
            invalid UTF-8, nesting limits, and unsupported extensions.
          </li>
        </ul>
        <p>
          This draft changes the wire layout. Earlier fixtures and benchmark results must be
          regenerated before they are used as evidence for this design. Performance comparisons
          should identify the codec, allocation and ownership policy, workload, and validation work.
        </p>
      </article>
    </div>

