            <div class="p-3.5 sm:p-4 grid sm:grid-cols-12 gap-2 sm:gap-4 items-start">
              <div class="sm:col-span-5 flex flex-wrap items-center gap-1.5 font-bold">
                <span class="text-ink/60 w-11 shrink-0">0x23</span>
