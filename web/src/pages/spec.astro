                <span class="px-1.5 py-0.5 bg-[#E5E0D5] border border-ink/30 text-ink rounded">
                  6e 00
                </span>
              </div>
              <div class="sm:col-span-7 font-sans text-sm text-ink/90 space-y-0.5">
