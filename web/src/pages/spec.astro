                </td>
              </tr>
              <tr>
                <td class="whitespace-nowrap font-bold">
                  <code>0x0D</code>
                </td>
                <td class="whitespace-nowrap font-bold">
                  <span class="px-1.5 py-0.5 bg-ink text-acid rounded">53</span>{' '}
                  <span class="px-1.5 py-0.5 bg-[#E5E0D5] text-ink rounded">3a 00</span>{' '}
                  <span class="px-1.5 py-0.5 bg-acid/40 text-ink rounded">03 05</span>
                </td>
                <td>
                  <div class="font-bold">
                    SchemaMeta Field #2 Header (<code>fields</code> map, <code>WireMap = 9</code>)
                  </div>
                  <div class="text-sm text-ink/80">
                    <code>53</code> &rarr; Tag: <code>(2 &lt;&lt; 4) | 9 = 41</code> &rarr;{' '}
                    <code>(41 &lt;&lt; 1) | 1 = 0x53</code> &bull; <code>3a 00</code> &rarr;
