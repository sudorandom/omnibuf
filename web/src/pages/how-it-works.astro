---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Capabilities from '../components/Capabilities.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="How It Works | OmniBuf"
  description="How OmniBuf achieves single-pass forward encoding, branchless Prefix-Varint decoding, raw message concatenation, and schema-less inspection."
>
  <Navbar currentPage="how-it-works" />

  <main id="main-content">
    <!-- Page Header -->
    <section class="relative pt-10 pb-8 sm:pt-16 sm:pb-10 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
      <h1 class="text-[2.6rem] sm:text-7xl lg:text-[5.5rem] font-bold tracking-tight leading-[0.94] text-ink uppercase">
        How OmniBuf
        <br />
        <span class="font-serif italic font-normal normal-case text-[#FF4F18] text-[3.1rem] sm:text-8xl lg:text-[6.2rem]">
          Works on the wire.
        </span>
      </h1>
      <p class="mt-6 max-w-3xl text-lg sm:text-2xl text-ink/85 font-medium leading-snug">
        New wire behaviors, schema-less inspection capabilities, and the encoding changes that make
        them possible.
      </p>
    </section>

    <Capabilities />
    <HowItWorks />

    <section class="py-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-t-2 border-ink no-print">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div class="font-mono text-sm sm:text-base font-bold uppercase text-ink/80">
          Next: See how OmniBuf performs on the wire
        </div>
        <div class="flex flex-wrap gap-3 font-mono text-sm sm:text-base">
          <a href="/benchmarks" class="os-btn px-5 py-2.5 bg-acid text-ink font-bold rounded-md">
            Benchmarks &amp; Comparisons &rarr;
          </a>
          <a href="/spec" class="os-btn px-5 py-2.5 bg-[#FAF8F2] text-ink font-bold rounded-md">
            Wire Specification &rarr;
          </a>
          <a href="/go" class="os-btn px-5 py-2.5 bg-[#FAF8F2] text-ink font-bold rounded-md">
            OmniBuf for Go &rarr;
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
