---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Capabilities from '../components/Capabilities.astro';
import Comparisons from '../components/Comparisons.astro';
import Footer from '../components/Footer.astro';

interface WirePart {
  label: string;
  tone: 'tag' | 'len' | 'meta' | 'val';
}

interface WireTypeRow {
  ids: string;
  title: string;
  names: string;
  protoTypes: string;
  parts: WirePart[];
  behavior: string;
}

const wireTypeRows: WireTypeRow[] = [
  {
    ids: 'Types 2 & 3',
    title: 'Booleans (0 Bytes)',
    names: 'WireBoolFalse · WireBoolTrue',
    protoTypes: 'bool',
    parts: [{ label: 'Tag (includes false / true)', tone: 'tag' }],
    behavior:
      'Booleans write zero bytes after the tag. Because false (Type 2) and true (Type 3) have their own wire types inside the tag byte itself, the very next byte in the stream is already the next field tag.',
  },
  {
    ids: 'Types 4..9',
    title: 'Fixed Width',
    names: 'WireFixed32/64 · WireSfixed32/64 · WireFloat32/64',
    protoTypes: 'fixed32, fixed64, sfixed32, sfixed64, float, double',
    parts: [
      { label: 'Tag', tone: 'tag' },
      { label: '4 or 8 Bytes (Little-Endian)', tone: 'val' },
    ],
    behavior:
      "Always writes 4 bytes (Types 4, 6, 8) or 8 bytes (Types 5, 7, 9) in little-endian order with no length prefix. Unsigned ints, signed two's-complement ints, and IEEE-754 floats each get their own wire type so a schema-less reader knows whether to print an unsigned int, a negative int, or a float.",
  },
  {
    ids: 'Types 0 & 1',
    title: 'Dynamic Width',
    names: 'WireUint · WireSint',
    protoTypes: 'uint32, uint64, int32, int64, sint32, sint64, enum',
    parts: [
      { label: 'Tag', tone: 'tag' },
      { label: '1, 2, 4, or 9-Byte Prefix-Varint', tone: 'val' },
    ],
    behavior:
      'Variable-width integers where the lowest bits of the first value byte tell the CPU whether to read 1, 2, 4, or 9 bytes in a single load instead of looping byte by byte. WireUint (0) stores unsigned integers directly, while WireSint (1) ZigZag-encodes signed integers and enums so small negative numbers like -1 take 1 byte.',
  },
  {
    ids: 'Types 10..12 & 15',
    title: 'Length-Delimited',
    names: 'WireString · WireBytes · WireSubMsg · WireExtended',
    protoTypes: 'string, bytes, message, extensions',
    parts: [
      { label: 'Tag', tone: 'tag' },
      { label: 'Byte Length', tone: 'len' },
      { label: 'Payload Bytes', tone: 'val' },
    ],
    behavior:
      'Every variable-length value starts with its byte length so a reader can skip past it in one step (pos += ByteLen). Instead of lumping strings, byte slices, and sub-messages into a single wire type, OmniBuf gives UTF-8 text (10), raw bytes (11), nested [Tag][Value] messages (12), and future extended types (15) distinct tags.',
  },
  {
    ids: 'Type 13',
    title: 'Arrays',
    names: 'WireArray',
    protoTypes: 'repeated T',
    parts: [
      { label: 'Tag', tone: 'tag' },
      { label: 'Byte Length', tone: 'len' },
      { label: 'Element Type (1B)', tone: 'meta' },
      { label: 'Element Count', tone: 'meta' },
      { label: 'Elements...', tone: 'val' },
    ],
    behavior:
      'Starts with the total byte length, a 1-byte wire type (0..12) for the elements, and the element count upfront so decoders can allocate the slice in one call. Elements are written back-to-back without repeating field tags, and boolean arrays (Element Type = 2) pack 8 booleans into each byte.',
  },
  {
    ids: 'Type 14',
    title: 'Maps',
    names: 'WireMap',
    protoTypes: 'map<K, V>',
    parts: [
      { label: 'Tag', tone: 'tag' },
      { label: 'Byte Length', tone: 'len' },
      { label: 'Key Type (1B)', tone: 'meta' },
      { label: 'Value Type (1B)', tone: 'meta' },
      { label: 'Entry Count', tone: 'meta' },
      { label: 'Key, Value...', tone: 'val' },
    ],
    behavior:
      'Starts with the total byte length, a 1-byte key wire type, a 1-byte value wire type, and the entry count, followed by alternating keys and values with no synthetic MapEntry wrapper messages.',
  },
];
---

<Layout
  title="How It Works | OmniBuf"
  description="How the OmniBuf binary wire format is structured: flat [Tag][Value] streams, Prefix-Varints, 4-bit wire types, single-pass length prefixes, and how it compares to other formats."
>
  <Navbar currentPage="how-it-works" />

  <main id="main-content">
    <!-- Page Header -->
    <section class="relative pt-10 pb-8 sm:pt-16 sm:pb-10 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
      <h1 class="text-[2.6rem] sm:text-7xl lg:text-[5.5rem] font-bold tracking-tight leading-[0.94] text-ink uppercase">
        How OmniBuf
        <br />
        <span class="font-serif italic font-normal normal-case text-[#FF4F18] text-[3.1rem] sm:text-8xl lg:text-[6.2rem]">
          Works on the wire.
        </span>
      </h1>
      <p class="mt-6 max-w-3xl text-lg sm:text-2xl text-ink/85 font-medium leading-snug">
        OmniBuf is a binary encoding format. A serialized message is a flat stream of{' '}
        <code>[Tag][Value]</code> fields with no file header or offset table.
      </p>
    </section>

    <!-- Binary Format Anatomy -->
    <section
      id="wire-format"
      class="pb-12 sm:pb-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto space-y-8"
    >
      <div class="border-t-2 border-ink pt-8 sm:pt-10 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start">
        <div class="lg:col-span-5 space-y-3.5 min-w-0">
          <h2 class="text-2xl sm:text-4xl font-bold uppercase tracking-tight leading-none">
            Anatomy of a{' '}
            <span class="font-serif italic font-normal normal-case text-[#FF4F18]">packet.</span>
          </h2>
          <p class="text-base sm:text-lg text-ink/85 leading-relaxed">
            Fields are written one after another as <code>[Tag][Value]</code> pairs. An empty
            message is 0 bytes. Each field starts with a Prefix-Varint tag that holds the field
            number in the upper bits and a <strong>4-bit wire type (0..15)</strong> in the low 4
            bits:
          </p>
          <div class="p-3.5 bg-[#FAF8F2] border-2 border-ink rounded-md font-mono space-y-1">
            <div class="text-sm sm:text-base font-bold">
              Tag = (FieldNumber &lt;&lt; 4) | WireType
            </div>
            <div class="text-xs text-ink/75">
              1-byte Prefix-Varints encode <code>x</code> as <code>(x &lt;&lt; 1) | 1</code>, so
              Field #1 (<code>0x10</code>) is <code>0x21</code> on the wire and value <code>1</code>{' '}
              is <code>0x03</code>.
            </div>
          </div>
          <p class="text-base sm:text-lg text-ink/85 leading-relaxed">
            That 4-bit wire type tells the decoder both the data type and how many bytes follow the
            tag. Booleans live right inside the tag (<strong>0 value bytes</strong>), integers and
            floats use either a 1, 2, 4, or 9-byte Prefix-Varint or a fixed 4 or 8-byte word, and
            every variable-length value (strings, byte slices, sub-messages, arrays, and maps)
            starts with its total byte length so a reader can either decode it or skip past it in
            one step.
          </p>
        </div>

        <!-- Concrete Wire Breakdown Example -->
        <div class="lg:col-span-7 min-w-0">
          <div class="os-window overflow-hidden">
            <div class="os-titlebar bg-[#E5E0D5]">
              <span class="font-mono text-sm sm:text-base font-bold uppercase">
                Example Packet on the Wire (8 Bytes)
              </span>
              <div class="os-stripes"></div>
            </div>
            <div class="p-4 sm:p-5 bg-ink text-paper font-mono text-xs sm:text-sm space-y-4">
              <!-- Protoscope-style message + contiguous wire bytes -->
              <div class="grid sm:grid-cols-2 gap-3">
                <div class="bg-[#1F1F1F] p-3 rounded border border-paper/15">
                  <div class="text-[11px] uppercase tracking-wider text-paper/60 font-bold mb-1.5">
                    Message (Protoscope)
                  </div>
                  <pre class="text-xs sm:text-sm leading-relaxed text-paper overflow-x-auto"><code>1: 1       <span class="text-paper/50"># id (uint)</span>
2: "FRA"   <span class="text-paper/50"># city (string)</span>
3: true    <span class="text-paper/50"># active (bool)</span></code></pre>
                </div>

                <div class="bg-[#1F1F1F] p-3 rounded border border-paper/15 flex flex-col justify-between">
                  <div>
                    <div class="text-[11px] uppercase tracking-wider text-paper/60 font-bold mb-1.5">
                      Wire Stream (8 Bytes)
                    </div>
                    <div class="text-sm sm:text-base font-bold text-acid tracking-wide leading-relaxed">
                      21 03 55 07 46 52 41 67
                    </div>
                  </div>
                  <div class="flex flex-wrap items-center gap-3 pt-2 mt-2 border-t border-paper/10 text-[11px] text-paper/75">
                    <span class="inline-flex items-center gap-1.5">
                      <span class="w-2.5 h-2.5 rounded-sm bg-acid inline-block"></span>
                      Tag
                    </span>
                    <span class="inline-flex items-center gap-1.5">
                      <span class="w-2.5 h-2.5 rounded-sm bg-[#FF4F18] inline-block"></span>
                      Length
                    </span>
                    <span class="inline-flex items-center gap-1.5">
                      <span class="w-2.5 h-2.5 rounded-sm bg-paper/25 border border-paper/40 inline-block"></span>
                      Value
                    </span>
                  </div>
                </div>
              </div>

              <!-- Compact 3-row field breakdown: all hex grouped together, description on the right -->
              <div class="bg-[#1F1F1F] rounded border border-paper/15 divide-y divide-paper/10">
                <!-- Field 1 -->
                <div class="grid sm:grid-cols-12 gap-2 items-center px-3 py-2.5">
                  <div class="sm:col-span-3 font-bold text-paper">#1 id</div>
                  <div class="sm:col-span-4 flex items-center gap-1.5">
                    <span class="px-1.5 py-0.5 bg-acid text-ink font-bold rounded">21</span>
                    <span class="px-1.5 py-0.5 bg-paper/15 text-paper font-bold rounded border border-paper/30">
                      03
                    </span>
                  </div>
                  <div class="sm:col-span-5 text-paper/75 text-xs">
                    WireUint (0) &middot; value = 1
                  </div>
                </div>

                <!-- Field 2 -->
                <div class="grid sm:grid-cols-12 gap-2 items-center px-3 py-2.5">
                  <div class="sm:col-span-3 font-bold text-paper">#2 city</div>
                  <div class="sm:col-span-4 flex items-center gap-1.5">
                    <span class="px-1.5 py-0.5 bg-acid text-ink font-bold rounded">55</span>
                    <span class="px-1.5 py-0.5 bg-[#FF4F18] text-white font-bold rounded">07</span>
                    <span class="px-1.5 py-0.5 bg-paper/15 text-paper font-bold rounded border border-paper/30">
                      46 52 41
                    </span>
                  </div>
                  <div class="sm:col-span-5 text-paper/75 text-xs">
                    WireString (10) &middot; len = 3 &middot; "FRA"
                  </div>
                </div>

                <!-- Field 3 -->
                <div class="grid sm:grid-cols-12 gap-2 items-center px-3 py-2.5">
                  <div class="sm:col-span-3 font-bold text-paper">#3 active</div>
                  <div class="sm:col-span-4 flex items-center gap-1.5">
                    <span class="px-1.5 py-0.5 bg-acid text-ink font-bold rounded">67</span>
                  </div>
                  <div class="sm:col-span-5 text-paper/75 text-xs">
                    WireBoolTrue (3) &middot; 0 value bytes
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Full-Width Grouped Wire Type Reference (0..15) -->
      <div id="wire-types" class="pt-6 sm:pt-8 space-y-6 scroll-mt-16">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div class="max-w-3xl">
            <h3 class="text-2xl sm:text-4xl font-bold uppercase tracking-tight leading-none">
              The 16{' '}
              <span class="font-serif italic font-normal normal-case text-[#FF4F18]">
                wire types.
              </span>
            </h3>
            <p class="mt-2.5 text-base sm:text-lg text-ink/80 leading-relaxed">
              Every field tag carries one of 16 wire types (<code>0..15</code>), grouped below by
              how the value bytes are framed on the wire. See{' '}
              <a href="/spec#sec-6" class="doc-link">
                Section 6 of the specification
              </a>{' '}
              for full byte-level rules.
            </p>
          </div>
        </div>

        <div class="border-2 border-ink rounded-md overflow-hidden bg-[#FAF8F2] divide-y-2 divide-ink/15">
          {wireTypeRows.map((row) => (
            <div class="p-4 sm:p-5 grid lg:grid-cols-12 gap-4 lg:gap-6 items-start">
              <div class="lg:col-span-4 space-y-1.5 min-w-0">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="font-mono px-2 py-0.5 bg-acid text-ink border border-ink text-xs font-bold uppercase rounded">
                    {row.ids}
                  </span>
                  <span class="text-base sm:text-lg font-bold text-ink">{row.title}</span>
                </div>
                <div class="font-mono text-xs text-ink/75 font-bold">{row.names}</div>
                <div class="font-mono text-xs text-ink/70">
                  Schema: <code>{row.protoTypes}</code>
                </div>
              </div>

              <div class="lg:col-span-8 space-y-2.5 min-w-0">
                <div class="flex flex-wrap items-center gap-1.5 font-mono text-xs font-bold">
                  {row.parts.map((part) => (
                    <span
                      class:list={[
                        'px-2 py-1 rounded border',
                        part.tone === 'tag'
                          ? 'bg-acid text-ink border-ink'
                          : part.tone === 'len'
                            ? 'bg-[#FF4F18] text-white border-ink'
                            : part.tone === 'meta'
                              ? 'bg-ink text-paper border-ink'
                              : 'bg-white text-ink border-ink/40',
                      ]}
                    >
                      {part.label}
                    </span>
                  ))}
                </div>
                <p class="text-sm sm:text-base text-ink/90 leading-relaxed">{row.behavior}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <HowItWorks />
    <Capabilities />
    <Comparisons />

    <section class="py-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-t-2 border-ink no-print">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div class="font-mono text-sm sm:text-base font-bold uppercase text-ink/80">
          More about OmniBuf
        </div>
        <div class="flex flex-wrap gap-3 font-mono text-sm sm:text-base">
          <a href="/spec" class="os-btn px-5 py-2.5 bg-acid text-ink font-bold rounded-md">
            Wire Specification &rarr;
          </a>
          <a href="/go" class="os-btn px-5 py-2.5 bg-[#FAF8F2] text-ink font-bold rounded-md">
            OmniBuf for Go &rarr;
          </a>
          <a href="/es" class="os-btn px-5 py-2.5 bg-[#FAF8F2] text-ink font-bold rounded-md">
            TypeScript / JS &rarr;
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
