---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Benchmarks from '../components/Benchmarks.astro';
import Comparisons from '../components/Comparisons.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Benchmarks & Format Comparisons | OmniBuf"
  description="Full serialization, deserialization, header-hop lookup, and wire size benchmarks comparing OmniBuf against Protobuf, FlatBuffers, Cap'n Proto, MessagePack, and JSON."
>
  <Navbar currentPage="benchmarks" />

  <main id="main-content">
    <!-- Page Header -->
    <section class="relative pt-10 pb-8 sm:pt-16 sm:pb-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
      <h1 class="text-[2.6rem] sm:text-7xl lg:text-[5.5rem] font-bold tracking-tight leading-[0.94] text-ink uppercase">
        Benchmarks &amp;
        <br />
        <span class="font-serif italic font-normal normal-case text-[#FF4F18] text-[3.1rem] sm:text-8xl lg:text-[6.2rem]">
          Format Comparisons.
        </span>
      </h1>

      <div class="mt-8 max-w-3xl space-y-3">
        <!-- prettier-ignore -->
        <p class="text-lg sm:text-2xl font-medium leading-snug text-ink/90">
          Head-to-head throughput, wire size, and field lookup measurements comparing OmniBuf (<a href="/go" class="doc-link">Go reference implementation</a>) against <a href="#compare-protobuf" class="doc-link">Protobuf</a>, <a href="#compare-flatbuffers" class="doc-link">FlatBuffers</a>, <a href="#compare-capnproto" class="doc-link">Cap'n Proto</a>, <a href="#compare-msgpack" class="doc-link">MessagePack</a>, and <a href="#compare-json" class="doc-link">JSON</a>.
        </p>
      </div>
    </section>

    <!-- Full Benchmark Bar Charts -->
    <Benchmarks />

    <!-- Full 5-Format Radar Comparisons -->
    <Comparisons />

    <!-- Methodology & Test Environment at the End (Clean architectural ledger row) -->
    <section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-t-2 border-ink">
      <div class="grid md:grid-cols-12 gap-6 lg:gap-8 items-start">
        <div class="md:col-span-4 space-y-2">
          <h2 class="text-2xl sm:text-3xl font-bold uppercase tracking-tight leading-snug">
            Benchmark Environment
          </h2>
          <div class="p-4 bg-ink text-paper rounded-md border-2 border-ink space-y-1.5 font-mono text-sm mt-3">
            <div class="text-acid font-bold uppercase">Hardware &amp; Runtime</div>
            <div>CPU: Apple M1 Pro (darwin/arm64)</div>
            <div>Compiler: Go 1.27.1</div>
            <div>
              Command: <code>just bench</code>
            </div>
          </div>
        </div>
        <div class="md:col-span-8 md:pt-2 space-y-4 text-base sm:text-lg text-ink/90 leading-relaxed max-w-[60ch]">
          <p>
            All benchmarks serialize and deserialize an identical 11-field message containing
            unsigned and ZigZag-signed integers, booleans, IEEE-754 floats, string lists, packed
            integer arrays, a 6-field nested sub-message, and a 4-element repeated sub-message list.
          </p>
          <!-- prettier-ignore -->
          <p class="text-sm sm:text-base text-ink/85">
            Source code for the harnesses and codec implementations is in <a href="https://github.com/sudorandom/omnibuf/blob/main/omnibuf_bench_test.go" target="_blank" rel="noopener noreferrer" class="doc-link font-mono">omnibuf_bench_test.go</a>, <a href="https://github.com/sudorandom/omnibuf/blob/main/opaque_table_bench_test.go" target="_blank" rel="noopener noreferrer" class="doc-link font-mono">opaque_table_bench_test.go</a>, <a href="https://github.com/sudorandom/omnibuf/blob/main/jsonv2_bench_test.go" target="_blank" rel="noopener noreferrer" class="doc-link font-mono">jsonv2_bench_test.go</a>, and <a href="https://github.com/sudorandom/omnibuf/blob/main/peer_codecs_test.go" target="_blank" rel="noopener noreferrer" class="doc-link font-mono">peer_codecs_test.go</a>. Previous benchmark output from <code>GOEXPERIMENT=jsonv2 go test -bench=. -benchmem</code> is checked into <a href="https://github.com/sudorandom/omnibuf/blob/main/testdata/benchmarks.txt" target="_blank" rel="noopener noreferrer" class="doc-link font-mono">testdata/benchmarks.txt</a>.
          </p>
        </div>
      </div>
    </section>

    <section class="py-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-t-2 border-ink no-print">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div class="font-mono text-sm sm:text-base font-bold uppercase text-ink/80">
          Read the complete wire specification or architectural breakdown
        </div>
        <div class="flex flex-wrap gap-3 font-mono text-sm sm:text-base">
          <a href="/go" class="os-btn px-5 py-2.5 bg-acid text-ink font-bold rounded-md">
            OmniBuf for Go &rarr;
          </a>
          <a href="/spec" class="os-btn px-5 py-2.5 bg-[#FAF8F2] text-ink font-bold rounded-md">
            Wire Specification &rarr;
          </a>
          <a
            href="/how-it-works"
            class="os-btn px-5 py-2.5 bg-[#FAF8F2] text-ink font-bold rounded-md"
          >
            How It Works &rarr;
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
