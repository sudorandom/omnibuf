---
import { benchmarkCategories } from '../data/benchmarks';

const goBenchmarkCategories = benchmarkCategories.filter((cat) => cat.unit !== 'B');
---

<section
  id="benchmarks"
  class="scroll-mt-16 py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-t-2 border-ink/15"
>
  <div class="max-w-3xl mb-6">
    <h2 class="text-3xl sm:text-5xl font-bold tracking-tight uppercase leading-none">
      Go <span class="font-serif italic font-normal normal-case text-[#FF4F18]">benchmarks.</span>
    </h2>
    <p class="mt-2.5 text-base sm:text-lg text-ink/80 font-medium">
      Here are the results for our 11-field test message. <strong>Shorter bars = Faster.</strong>
    </p>
  </div>

  <div class="grid lg:grid-cols-2 gap-5 items-start">
    {goBenchmarkCategories.map((cat) => (
      <div class="os-window overflow-hidden">
        <div class="os-titlebar bg-[#E5E0D5]">
          <span class="font-mono text-xs sm:text-sm font-bold uppercase">{cat.title}</span>
          <div class="os-stripes" />
        </div>

        <div class="p-3.5 sm:p-4 bg-[#FAF8F2] space-y-1">
          <p class="text-xs sm:text-sm text-ink/85 leading-snug pb-1.5 max-w-[70ch]">
            {cat.methodology}
          </p>
          {(() => {
            const omniVal =
              cat.rows.find((row) => row.baseline)?.val ??
              cat.rows.find((row) => row.highlight)?.val ??
              cat.rows[0].val;
            return cat.rows.map((r) => {
              const numPct = Math.max(2, Math.min(100, (r.val / cat.maxVal) * 100));
              const pct = numPct.toFixed(1);
              let ratioStr = '1.0x (base)';
              if (r.val !== omniVal) {
                ratioStr =
                  r.val < omniVal
                    ? `${(omniVal / r.val).toFixed(1)}x faster`
                    : `${(r.val / omniVal).toFixed(1)}x slower`;
              }
              return (
                <div
                  class:list={[
                    'grid grid-cols-12 gap-x-2 gap-y-1 items-center px-2.5 py-1 rounded min-w-0',
                    r.baseline
                      ? 'bg-acid/45 border-2 border-ink shadow-[2px_2px_0px_#111111] font-bold'
                      : r.highlight
                        ? 'bg-acid/25 border-2 border-dashed border-ink font-bold'
                        : 'border border-ink/15 bg-white',
                  ]}
                >
                  <div
                    class="col-span-12 sm:col-span-5 font-mono text-xs text-ink truncate"
                    title={r.name}
                  >
                    {r.name}
                  </div>
                  <div class="col-span-6 sm:col-span-3 flex items-center min-w-0">
                    <div class="w-full bg-[#E5E0D5] h-3.5 border border-ink rounded-sm overflow-hidden">
                      <div
                        class:list={[
                          'h-full',
                          numPct < 99.5 && 'border-r border-ink',
                          r.highlight ? 'bench-bar-omni' : 'bench-bar-competitor',
                        ]}
                        style={`width: ${pct}%;`}
                      />
                    </div>
                  </div>
                  <div class="col-span-6 sm:col-span-4 text-right font-mono text-xs tabular-nums whitespace-nowrap leading-none">
                    <span class="font-bold text-ink">{ratioStr}</span>{' '}
                    <span class="text-ink/70 font-normal">
                      ({r.val.toLocaleString('en-US')} {cat.unit})
                    </span>
                  </div>
                </div>
              );
            });
          })()}
        </div>
      </div>
    ))}
  </div>

  <!-- Benchmark Environment & Reproducibility -->
  <div class="mt-8 pt-8 border-t-2 border-ink/15 grid md:grid-cols-12 gap-6 lg:gap-8 items-start">
    <div class="md:col-span-4 space-y-2">
      <h3 class="text-xl sm:text-2xl font-bold uppercase tracking-tight leading-snug">
        Benchmark Environment
      </h3>
      <div class="p-4 bg-ink text-paper rounded-md border-2 border-ink space-y-1.5 font-mono text-sm mt-3">
        <div class="text-acid font-bold uppercase">Hardware &amp; Runtime</div>
        <div>CPU: Apple M1 Pro (darwin/arm64)</div>
        <div>Compiler: Go 1.27.1</div>
        <div>
          Samples: 8 × 200 ms, CPU=1
        </div>
        <div>Updated: 2026-10-28</div>
      </div>
    </div>
    <div class="md:col-span-8 md:pt-1 space-y-3.5 text-base sm:text-lg text-ink/85 leading-relaxed max-w-[65ch]">
      <p>
        These results are medians of eight runs on an M1 Pro MacBook Pro with Go 1.27.1
        and <code>GOEXPERIMENT=jsonv2</code>, using <code>-benchtime=200ms -count=8 -cpu=1</code>. Each test encodes and
        decodes the same <code>PeerUpdate</code> message, which has 11 fields (a mix of numbers,
        booleans, strings, a nested <code>Location</code> message, and a list of 4{' '}
        <code>Neighbor</code> messages).
      </p>
      <!-- prettier-ignore -->
      <p class="text-sm sm:text-base text-ink/80">
        If you want to run them yourself or check how each library is set up, take a look at <a href="https://github.com/sudorandom/omnibuf/blob/main/omnibuf_bench_test.go" target="_blank" rel="noopener noreferrer" class="doc-link font-mono">omnibuf_bench_test.go</a>, <a href="https://github.com/sudorandom/omnibuf/blob/main/opaque_table_bench_test.go" target="_blank" rel="noopener noreferrer" class="doc-link font-mono">opaque_table_bench_test.go</a>, <a href="https://github.com/sudorandom/omnibuf/blob/main/jsonv2_bench_test.go" target="_blank" rel="noopener noreferrer" class="doc-link font-mono">jsonv2_bench_test.go</a>, and <a href="https://github.com/sudorandom/omnibuf/blob/main/peer_codecs_test.go" target="_blank" rel="noopener noreferrer" class="doc-link font-mono">peer_codecs_test.go</a> in the repo. The raw output and exact commands are recorded in <a href="https://github.com/sudorandom/omnibuf/blob/main/testdata/benchmarks.txt" target="_blank" rel="noopener noreferrer" class="doc-link font-mono">testdata/benchmarks.txt</a>.
      </p>
    </div>
  </div>
</section>
