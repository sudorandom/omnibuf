---
import { benchmarkCategories } from '../data/benchmarks';

const goEncodeCat = benchmarkCategories.find((cat) => cat.title === 'Full Message Encode Speed');
const goDecodeCat = benchmarkCategories.find((cat) => cat.title === 'Full Message Decode Speed');

const heroEncodeRows = (goEncodeCat?.rows ?? []).filter(
  (r) => (r.baseline || !r.highlight) && r.name !== 'JSON (encoding/json/v2)',
);
const heroDecodeRows = (goDecodeCat?.rows ?? []).filter(
  (r) => (r.baseline || !r.highlight) && r.name !== 'JSON (encoding/json/v2)',
);
const maxHeroEnc = Math.max(...heroEncodeRows.map((r) => r.val), 1);
const maxHeroDec = Math.max(...heroDecodeRows.map((r) => r.val), 1);

const decodeByName = new Map(heroDecodeRows.map((r) => [r.name, r.val]));
const butterflyRows = heroEncodeRows.map((r) => {
  const decVal = decodeByName.get(r.name) ?? r.val;
  return {
    name: r.name,
    baseline: Boolean(r.baseline),
    encVal: r.val,
    decVal,
    encPct: Math.max(4.5, Math.min(100, (r.val / maxHeroEnc) * 100)).toFixed(1),
    decPct: Math.max(4.5, Math.min(100, (decVal / maxHeroDec) * 100)).toFixed(1),
  };
});
const omniRow = butterflyRows.find((r) => r.baseline) ?? butterflyRows[0];
const restRows = butterflyRows.filter((r) => !r.baseline);
