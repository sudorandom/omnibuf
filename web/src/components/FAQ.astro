---
interface FAQItem {
  question: string;
  paragraphs: string[];
}

const faqItems: FAQItem[] = [
  {
    question: 'Why is it named OmniBuf?',
    paragraphs: [
      'The name reflects a more complete Protobuf that goes further than the original wire encoding. Standard Protobuf requires a schema just to make sense of raw bytes, and it will never compromise on carrying field metadata on the wire.',
      'OmniBuf payloads can always be parsed into explicit types without a schema, and can optionally embed field names (Field #0) when you want full named JSON output straight from a binary packet.',
    ],
  },
  {
    question: 'Why a new format?',
    paragraphs: [
      'The main goal is simple: we want a better Protobuf, and showing a concrete re-imagining of the wire format can help push the ecosystem further.',
      "Protobuf is generally fine, and JSON is generally fine, but both have rough edges. Protobuf's 2001 wire format is slow to decode and opaque in logs; JSON is bulky and breaks on 64-bit integers and binary data. At the same time, Protobuf's IDL methodology is genuinely great: schema-first development with explicit field numbers lets systems adapt and evolve at a much faster pace. OmniBuf keeps the <code>.proto</code> schema workflow intact and shows what becomes possible when you modernize the wire encoding underneath it.",
    ],
  },
  {
    question: 'Do I have to rewrite my .proto files?',
    paragraphs: [
      'No. OmniBuf uses standard proto3 and Editions (2023, 2024) field numbers, scalar types, nested messages, repeated lists, and maps without requiring a custom IDL or builder API.',
    ],
  },
  {
    question: 'What languages are supported?',
    paragraphs: [
      'Right now, <a href="/go" class="doc-link">Go</a> is implemented (supporting plain Go structs with <code>omnibuf:"..."</code> struct tags, existing <code>.pb.go</code> structs, and <code>protoc-gen-omnibuf</code> code generation). The wire specification is language-agnostic and built around standard little-endian loads and hardware bit-scans, with additional language implementations planned as the specification stabilizes.',
    ],
  },
];

const stripHtml = (s: string) => s.replace(/<[^>]+>/g, '');

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.paragraphs.map(stripHtml).join('\n\n'),
    },
  })),
};
---

<section
  id="faq"
  class="py-16 sm:py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-t-2 border-ink/15"
>
  <div class="max-w-3xl mb-10">
    <h2 class="text-3xl sm:text-5xl font-bold tracking-tight uppercase leading-none">
      Frequently asked{' '}
      <span class="font-serif italic font-normal normal-case text-[#FF4F18]">questions.</span>
    </h2>
  </div>

  <div class="border-t-2 border-ink divide-y-2 divide-ink/20">
    {faqItems.map((item) => (
      <div class="py-8 sm:py-10 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start">
        <h3 class="lg:col-span-5 text-xl sm:text-2xl font-bold uppercase tracking-tight text-ink leading-snug">
          {item.question}
        </h3>
        <div class="lg:col-span-7 space-y-3.5 text-base sm:text-lg text-ink/85 leading-relaxed max-w-[65ch] min-w-0">
          {item.paragraphs.map((paragraph) => (
            <p set:html={paragraph} />
          ))}
        </div>
      </div>
    ))}
  </div>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
</section>
