---
interface FAQItem {
  id?: string;
  question: string;
  paragraphs: string[];
}

const faqItems: FAQItem[] = [
  {
    id: 'status',
    question: 'Is the wire format frozen?',
    paragraphs: [
      'Not yet. OmniBuf is at <strong>v0.1 (experimental)</strong> while I gather feedback on the wire format before locking down v1.0. If you spot something that should change, please open an issue on <a href="https://github.com/sudorandom/omnibuf" target="_blank" rel="noopener noreferrer" class="doc-link">GitHub</a>.',
    ],
  },
  {
    id: 'faq-proto',
    question: 'Do I need a .proto file?',
    paragraphs: [
      'No. You can put <code>omnibuf:"1"</code> tags on Go structs (just like <code>json:"id"</code> tags) or use <code>defineMessage()</code> in TypeScript. If the reader does not even have your struct definition, OmniBuf\'s 16 explicit wire types still let it decode the values, and turning on <strong>Field #0</strong> includes the field names in the packet (written once per type, not repeated on every array item).',
    ],
  },
  {
    id: 'faq-grpc',
    question: 'Can I use OmniBuf with gRPC or Connect?',
    paragraphs: [
      'Yes. OmniBuf is a serialization format only, not an RPC framework. Almost every <a href="https://grpc.io/" target="_blank" rel="noopener noreferrer" class="doc-link">gRPC</a> implementation (and <a href="https://connectrpc.com/" target="_blank" rel="noopener noreferrer" class="doc-link">Connect</a>) lets you register a custom wire codec (such as <code>encoding.RegisterCodec</code> in <code>grpc-go</code>), so you can swap in OmniBuf without changing your generated service stubs.',
    ],
  },
  {
    id: 'faq-presence',
    question: 'How does field presence work?',
    paragraphs: [
      "With <code>.proto</code> files, OmniBuf follows Protobuf's rules, including <code>proto3</code> <code>optional</code> and Editions (2023 and 2024). On plain Go structs, pointer fields track explicit presence and <code>omitempty</code> skips zero values.",
    ],
  },
  {
    id: 'faq-unknown',
    question: 'What happens to unknown fields?',
    paragraphs: [
      'Go structs skip over unknown fields without storing them (so re-marshaling that struct drops them), while TypeScript keeps them in <code>$unknown</code>. If you are building a proxy that forwards packets, use <code>Opaque</code> views or <code>SpliceFields</code> to read or update fields directly on the raw byte slice without losing unknown fields.',
    ],
  },
  {
    id: 'faq-deterministic',
    question: 'Is the encoding deterministic?',
    paragraphs: [
      'Normal encoding is not canonical because Go randomizes map order. When you need reproducible bytes for hashing or tests, use <code>omnibuf.MarshalDeterministic</code> to sort fields and map keys.',
    ],
  },
  {
    id: 'faq-languages',
    question: 'What languages are supported?',
    paragraphs: [
      '<a href="/go" class="doc-link">Go</a> and <a href="/es" class="doc-link">TypeScript / JavaScript</a> today, with Rust, C++, and Python planned once v1.0 of the wire spec is finalized.',
    ],
  },
];

const stripHtml = (s: string) => s.replace(/<[^>]+>/g, '');

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.paragraphs.map(stripHtml).join('\n\n'),
    },
  })),
};
---

<section
  id="faq"
  class="py-16 sm:py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-t-2 border-ink/15"
>
  <div class="max-w-3xl mb-10">
    <h2 class="text-3xl sm:text-5xl font-bold tracking-tight uppercase leading-none">
      Frequently asked{' '}
      <span class="font-serif italic font-normal normal-case text-[#FF4F18]">questions.</span>
    </h2>
  </div>

  <div class="border-t-2 border-ink divide-y-2 divide-ink/20">
    {faqItems.map((item) => (
      <div
        id={item.id}
        class="scroll-mt-16 py-8 sm:py-10 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start"
      >
        <h3 class="lg:col-span-5 text-xl sm:text-2xl font-bold uppercase tracking-tight text-ink leading-snug">
          {item.question}
        </h3>
        <div class="lg:col-span-7 space-y-3.5 text-base sm:text-lg text-ink/85 leading-relaxed max-w-[65ch] min-w-0">
          {item.paragraphs.map((paragraph) => (
            <p set:html={paragraph} />
          ))}
        </div>
      </div>
    ))}
  </div>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
</section>
