---
interface FAQItem {
  id?: string;
  question: string;
  paragraphs: string[];
}

const faqItems: FAQItem[] = [
  {
    id: 'status',
    question: 'What is the current stability status? Is the v1.0 wire format frozen?',
    paragraphs: [
      'OmniBuf is still <strong>experimental</strong>. The <a href="/go" class="doc-link">Go</a> and <a href="/es" class="doc-link">TypeScript / JS</a> implementations both pass the same conformance test suite, so they produce identical bytes, but I haven\'t frozen the v1.0 wire specification yet.',
      'If you try it out and find something in the wire format or library APIs that should be changed before v1.0 is locked down, please open an issue on <a href="https://github.com/sudorandom/omnibuf" target="_blank" rel="noopener noreferrer" class="doc-link">GitHub</a>.',
    ],
  },
  {
    question: 'Why is it named OmniBuf?',
    paragraphs: [
      "The name comes from wanting a more complete version of Protobuf. When Protobuf encodes a message, it throws away enough type information that you can't reliably decode the binary without the original <code>.proto</code> file, and there is no option to include field names when you want them.",
      'In OmniBuf, the wire types are specific enough that you can always decode the values in a packet without a schema. You can also opt into writing the field names into Field #0 at the start of the message when you want self-describing packets.',
    ],
  },
  {
    question: 'Why a new format?',
    paragraphs: [
      "I spend a lot of time working with Protobuf and JSON, and I wanted to see how much faster a binary format could be if we fixed a few of Protobuf's 2001 design choices while keeping its good parts.",
      'I also wanted a format that doesn\'t care how you define your types. If you like <code>.proto</code> files for sharing schemas across languages, you can use <code>.proto</code> files. If you just have a <a href="/go#struct-tags" class="doc-link">Go struct</a> or a <a href="/es#define-message" class="doc-link">TypeScript type</a> and want to serialize it without setting up a code generator, you can do that too, and both produce the same wire format.',
    ],
  },
  {
    question: 'Do I have to use or rewrite .proto files?',
    paragraphs: [
      "No. If you already have proto3 or Editions (2023, 2024) <code>.proto</code> files, they work as-is. If you don't use <code>.proto</code> files, you can use struct tags in Go or <code>defineMessage()</code> in TypeScript.",
    ],
  },
  {
    question: 'What languages are supported?',
    paragraphs: [
      'Right now there are libraries for <a href="/go" class="doc-link">Go</a> and <a href="/es" class="doc-link">TypeScript / JavaScript</a>. Both support all three usage modes (plain structs/objects, existing Protobuf types, and code generation). Once the v1.0 wire specification is finalized, I plan to add Rust, C++, and Python.',
    ],
  },
];

const stripHtml = (s: string) => s.replace(/<[^>]+>/g, '');

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.paragraphs.map(stripHtml).join('\n\n'),
    },
  })),
};
---

<section
  id="faq"
  class="py-16 sm:py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-t-2 border-ink/15"
>
  <div class="max-w-3xl mb-10">
    <h2 class="text-3xl sm:text-5xl font-bold tracking-tight uppercase leading-none">
      Frequently asked{' '}
      <span class="font-serif italic font-normal normal-case text-[#FF4F18]">questions.</span>
    </h2>
  </div>

  <div class="border-t-2 border-ink divide-y-2 divide-ink/20">
    {faqItems.map((item) => (
      <div
        id={item.id}
        class="scroll-mt-16 py-8 sm:py-10 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start"
      >
        <h3 class="lg:col-span-5 text-xl sm:text-2xl font-bold uppercase tracking-tight text-ink leading-snug">
          {item.question}
        </h3>
        <div class="lg:col-span-7 space-y-3.5 text-base sm:text-lg text-ink/85 leading-relaxed max-w-[65ch] min-w-0">
          {item.paragraphs.map((paragraph) => (
            <p set:html={paragraph} />
          ))}
        </div>
      </div>
    ))}
  </div>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
</section>
