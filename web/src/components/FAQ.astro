---
interface FAQItem {
  question: string;
  paragraphs: string[];
}

const faqItems: FAQItem[] = [
  {
    question: 'Why is it named OmniBuf?',
    paragraphs: [
      'The name reflects a more complete Protobuf that goes further than the original wire encoding. Standard Protobuf requires a schema just to make sense of raw bytes, and it will never compromise on carrying field metadata on the wire.',
      'OmniBuf payloads can always be parsed into explicit types without a schema, and can optionally embed field names (Field #0) when you want full named JSON output straight from a binary packet.',
    ],
  },
  {
    question: 'Why a new format?',
    paragraphs: [
      "Protobuf is generally fine, and JSON is generally fine, but both have rough edges. Protobuf's 2001 wire format is slow to decode and opaque in logs; JSON is bulky and breaks on 64-bit integers and binary data.",
      "At the same time, Protobuf's IDL methodology is genuinely great. Schema-first development with explicit field numbers lets systems adapt and evolve at a much faster pace. OmniBuf keeps the .proto schema workflow and replaces only the wire encoding.",
    ],
  },
  {
    question: 'How does it compare to vtprotobuf?',
    paragraphs: [
      'vtprotobuf speeds up Go Protobuf by generating unrolled LEB128 loops and backwards-writing SizeVT() pre-passes, but it is still bound by the 2001 wire format.',
      'Because OmniBuf uses single-pass forward encoding and 1-load Prefix-Varints, protoc-gen-omnibuf runs over 50% faster on Marshal and over 2x faster on Read-Modify-Write while generating less than half the code.',
    ],
  },
  {
    question: 'Do I have to rewrite my .proto files?',
    paragraphs: [
      'No. OmniBuf compiles standard proto3 and Editions (2023, 2024) definitions using protoc-gen-omnibuf. By default it attaches fast encode and decode methods directly onto your existing .pb.go structs, so you do not have to rewrite application code around a custom builder API.',
    ],
  },
  {
    question: 'What languages are supported?',
    paragraphs: [
      'Right now, only Go is implemented. The wire specification is language-agnostic and built around standard little-endian loads and hardware bit-scans, with additional language implementations planned as the specification stabilizes.',
    ],
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.paragraphs.join('\n\n'),
    },
  })),
};
---

<section
  id="faq"
  class="py-16 sm:py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-t-2 border-ink/15"
>
  <div class="max-w-3xl mb-10">
    <h2 class="text-3xl sm:text-5xl font-bold tracking-tight uppercase leading-none">
      Frequently asked{' '}
      <span class="font-serif italic font-normal normal-case text-[#FF4F18]">questions.</span>
    </h2>
  </div>

  <div class="border-t-2 border-ink divide-y-2 divide-ink/20">
    {faqItems.map((item) => (
      <div class="py-7 sm:py-9 grid lg:grid-cols-12 gap-4 lg:gap-8 items-start">
        <h3 class="lg:col-span-5 text-xl sm:text-2xl font-bold uppercase tracking-tight text-ink leading-snug">
          {item.question}
        </h3>
        <div class="lg:col-span-7 space-y-3.5 text-base sm:text-lg text-ink/90 leading-relaxed max-w-[68ch]">
          {item.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      </div>
    ))}
  </div>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
</section>
