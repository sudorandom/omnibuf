---
import { Code } from 'astro:components';

const structTagSnippet = `type Peer struct {
	ID        uint64            \`omnibuf:"1,name=peer_id"\`
	Router    string            \`omnibuf:"2,name=router"\`
	Active    bool              \`omnibuf:"3,name=active"\`
	LatencyUS uint32            \`omnibuf:"4,name=latency_us,wire=fixed32,omitempty"\`
	Prefixes  []uint32          \`omnibuf:"5,name=prefixes"\`
	Labels    map[string]string \`omnibuf:"6,name=labels,omitempty"\`
	Internal  string            \`omnibuf:"-"\`
}

pkt, err := omnibuf.Marshal(&Peer{ID: 64512, Router: "rtr-01", Active: true})
var out Peer
err = omnibuf.Unmarshal(pkt, &out)`;

const pbGoSnippet = `// Encode any existing *pb.Peer (.pb.go) struct with zero extra codegen:
pkt, err := omnibuf.Marshal(msg)

// Decode back into a reused or new *pb.Peer struct:
var out pb.Peer
err = omnibuf.Unmarshal(pkt, &out)`;

const bufGenYamlSnippet = `version: v2
plugins:
  - local: protoc-gen-go
    out: gen
    opt: paths=source_relative
  - local: protoc-gen-omnibuf
    out: gen
    opt: paths=source_relative`;

const generatedMethodsSnippet = `// Allocate a new slice, or append to a pooled buffer (buf[:0]):
pkt := msg.MarshalOmniBufAppend(nil)

// Decode back into *pb.Peer (pass true to alias strings zero-copy):
var out pb.Peer
err := out.UnmarshalOmniBuf(pkt, false)`;
---

<section
  id="quickstart"
  class="scroll-mt-16 py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-t-2 border-ink/15"
>
  <div class="max-w-3xl mb-8">
    <h2 class="text-3xl sm:text-5xl font-bold tracking-tight uppercase leading-none">
      Three ways to use{' '}
      <span class="font-serif italic font-normal normal-case text-[#FF4F18]">OmniBuf in Go.</span>
    </h2>
    <p class="mt-3 text-lg sm:text-xl text-ink/80 font-medium">
      Start with plain Go structs or existing <code>.pb.go</code> types with zero build changes, or
      add <code>protoc-gen-omnibuf</code> for generated single-pass methods and lazy{' '}
      <code>Opaque</code> readers.
    </p>
  </div>

  <div class="border-t-2 border-ink divide-y-2 divide-ink/20">
    <!-- Tier 1: Plain Go Structs with omnibuf Tags -->
    <div
      id="struct-tags"
      class="scroll-mt-16 py-8 sm:py-12 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start"
    >
      <div class="lg:col-span-5 space-y-3.5 min-w-0">
        <div class="font-mono text-xs font-bold uppercase tracking-wider text-[#FF4F18]">
          Tier 1 &middot; No .proto Required
        </div>
        <h3 class="text-2xl sm:text-3xl font-bold uppercase tracking-tight leading-snug">
          Tag plain Go structs with <code>omnibuf:"..."</code>
        </h3>
        <p class="text-base sm:text-lg text-ink/85 leading-relaxed">
          Tag exported fields with <code>omnibuf:"..."</code> and pass a struct pointer directly to{' '}
          <code>omnibuf.Marshal</code> and <code>omnibuf.Unmarshal</code>. On first use, OmniBuf
          caches each field's byte offset and wire type so subsequent calls read and write struct
          memory directly without per-call reflection:
        </p>
        <ul class="space-y-2 text-sm sm:text-base text-ink/85 leading-relaxed list-disc pl-5">
          <li>
            <code>1..65535</code> sets the wire field number (or <code>-</code> to ignore a field).
          </li>
          <li>
            <code>name=...</code> sets the field name written to <code>Field #0</code> (defaults to
            the Go field name).
          </li>
          <li>
            <code>wire=...</code> overrides the inferred wire type (<code>uint</code>,{' '}
            <code>sint</code>, <code>fixed32</code>, <code>fixed64</code>, <code>string</code>,{' '}
            <code>bytes</code>).
          </li>
          <li>
            <code>omitempty</code> skips encoding when the field holds its zero value.
          </li>
        </ul>
      </div>

      <div class="lg:col-span-7 min-w-0">
        <div class="p-4 sm:p-5 bg-ink text-paper rounded-md font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border-2 border-ink [&>pre]:!bg-transparent [&>pre]:!p-0 [&>pre]:!m-0 [&>pre]:!border-0">
          <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/15">
            <div class="text-xs font-bold uppercase text-acid">Tier 1: Plain Go Structs</div>
            <button
              type="button"
              data-copy={structTagSnippet}
              class="copy-snippet-btn min-w-[4.75rem] text-center px-2.5 py-1 text-xs font-bold uppercase bg-paper/15 hover:bg-acid hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-acid text-paper border border-paper/30 rounded shrink-0 transition"
            >
              Copy
            </button>
          </div>
          <Code code={structTagSnippet} lang="go" theme="github-dark" />
        </div>
      </div>
    </div>

    <!-- Tier 2: Drop-in Table Engine on Existing .pb.go Structs -->
    <div
      id="pb-go-structs"
      class="scroll-mt-16 py-8 sm:py-12 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start"
    >
      <div class="lg:col-span-5 space-y-4 min-w-0">
        <div class="font-mono text-xs font-bold uppercase tracking-wider text-[#FF4F18]">
          Tier 2 &middot; Zero Extra Codegen
        </div>
        <h3 class="text-2xl sm:text-3xl font-bold uppercase tracking-tight leading-snug">
          Drop-in on existing <code>.pb.go</code> structs
        </h3>
        <p class="text-base sm:text-lg text-ink/85 leading-relaxed">
          Already generating <code>.pb.go</code> files with <code>protoc-gen-go</code>? Pass your
          existing structs directly to <code>omnibuf.Marshal</code> and{' '}
          <code>omnibuf.Unmarshal</code> with no extra plugin step. OmniBuf inspects the struct tags
          once per type, caches an unsafe pointer-offset table, and runs with zero heap allocations
          on reused structs.
        </p>
        <div class="p-4 sm:p-5 bg-[#FAF8F2] border-2 border-ink shadow-[4px_4px_0px_#111111] rounded-md font-mono text-sm sm:text-base space-y-1.5">
          <div class="font-bold text-ink">~2.5x to 3x faster than Go Protobuf</div>
          <div class="font-bold text-[#FF4F18]">4x to 11x faster than JSON &amp; MsgPack</div>
          <div class="text-ink/80 text-xs sm:text-sm">
            0 allocs on reused structs &middot; No build changes
          </div>
        </div>
      </div>

      <div class="lg:col-span-7 min-w-0">
        <div class="p-4 sm:p-5 bg-ink text-paper rounded-md font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border-2 border-ink [&>pre]:!bg-transparent [&>pre]:!p-0 [&>pre]:!m-0 [&>pre]:!border-0">
          <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/15">
            <div class="text-xs font-bold uppercase text-acid">Tier 2: Existing .pb.go Structs</div>
            <button
              type="button"
              data-copy={pbGoSnippet}
              class="copy-snippet-btn min-w-[4.75rem] text-center px-2.5 py-1 text-xs font-bold uppercase bg-paper/15 hover:bg-acid hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-acid text-paper border border-paper/30 rounded shrink-0 transition"
            >
              Copy
            </button>
          </div>
          <Code code={pbGoSnippet} lang="go" theme="github-dark" />
        </div>
      </div>
    </div>

    <!-- Tier 3: Buf / protoc Code Generation -->
    <div
      id="plugin-tiers"
      class="scroll-mt-16 py-8 sm:py-12 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start"
    >
      <div class="lg:col-span-5 space-y-4 min-w-0">
        <div class="font-mono text-xs font-bold uppercase tracking-wider text-[#FF4F18]">
          Tier 3 &middot; Maximum Performance
        </div>
        <h3 class="text-2xl sm:text-3xl font-bold uppercase tracking-tight leading-snug">
          Generate methods with <code>protoc-gen-omnibuf</code>
        </h3>
        <p class="text-base sm:text-lg text-ink/85 leading-relaxed">
          Add <code>protoc-gen-omnibuf</code> to your <code>buf.gen.yaml</code> (supports standard{' '}
          <code>proto3</code> and Editions <code>2023</code>/<code>2024</code> schemas). By default,
          the plugin attaches single-pass <code>MarshalOmniBuf</code>,{' '}
          <code>MarshalOmniBufAppend</code>, <code>UnmarshalOmniBuf</code>, and lazy{' '}
          <code>Opaque*</code> views directly onto your existing <code>.pb.go</code> structs.
        </p>
        <div class="p-4 sm:p-5 bg-ink text-paper border-2 border-ink shadow-[4px_4px_0px_#111111] rounded-md font-mono text-sm sm:text-base space-y-1.5">
          <div class="text-acid font-bold">~6x faster encode &amp; 8x faster decode</div>
          <div class="text-white font-bold">
            &gt;50% faster than vtprotobuf (&gt;2x on Read-Modify-Write)
          </div>
          <div class="text-paper/75 text-xs sm:text-sm">
            Under half the generated code &middot; Zero-alloc Opaque views
          </div>
        </div>
      </div>

      <div class="lg:col-span-7 space-y-3.5 min-w-0">
        <div class="p-4 sm:p-5 bg-ink text-paper rounded-md font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border-2 border-ink [&>pre]:!bg-transparent [&>pre]:!p-0 [&>pre]:!m-0 [&>pre]:!border-0">
          <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/15">
            <div class="text-xs font-bold uppercase text-acid">Tier 3: buf.gen.yaml</div>
            <button
              type="button"
              data-copy={bufGenYamlSnippet}
              class="copy-snippet-btn min-w-[4.75rem] text-center px-2.5 py-1 text-xs font-bold uppercase bg-paper/15 hover:bg-acid hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-acid text-paper border border-paper/30 rounded shrink-0 transition"
            >
              Copy
            </button>
          </div>
          <Code code={bufGenYamlSnippet} lang="yaml" theme="github-dark" />
        </div>

        <div class="p-4 sm:p-5 bg-ink text-paper rounded-md font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border-2 border-ink">
          <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/15">
            <div class="text-xs font-bold uppercase text-acid">Install Plugin &amp; Generate</div>
            <button
              type="button"
              data-copy="go install github.com/sudorandom/omnibuf/cmd/protoc-gen-omnibuf@latest && buf generate"
              class="copy-snippet-btn min-w-[4.75rem] text-center px-2.5 py-1 text-xs font-bold uppercase bg-paper/15 hover:bg-acid hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-acid text-paper border border-paper/30 rounded shrink-0 transition"
            >
              Copy
            </button>
          </div>
          <pre class="leading-relaxed whitespace-pre"><code><span class="text-paper/75 select-none">$ </span>go install github.com/sudorandom/omnibuf/cmd/protoc-gen-omnibuf@latest
<span class="text-paper/75 select-none">$ </span><span class="text-acid font-bold">buf generate</span></code></pre>
        </div>

        <div class="p-4 sm:p-5 bg-ink text-paper rounded-md font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border-2 border-ink [&>pre]:!bg-transparent [&>pre]:!p-0 [&>pre]:!m-0 [&>pre]:!border-0">
          <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/15">
            <div class="text-xs font-bold uppercase text-acid">Generated Single-Pass Methods</div>
            <button
              type="button"
              data-copy={generatedMethodsSnippet}
              class="copy-snippet-btn min-w-[4.75rem] text-center px-2.5 py-1 text-xs font-bold uppercase bg-paper/15 hover:bg-acid hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-acid text-paper border border-paper/30 rounded shrink-0 transition"
            >
              Copy
            </button>
          </div>
          <Code code={generatedMethodsSnippet} lang="go" theme="github-dark" />
        </div>
      </div>
    </div>
  </div>
  <div id="copy-live-region" class="sr-only" aria-live="polite"></div>
</section>

<script>
  const liveRegion = document.getElementById('copy-live-region');
  const timers = new WeakMap<HTMLButtonElement, number>();
  document.querySelectorAll<HTMLButtonElement>('.copy-snippet-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.getAttribute('data-copy');
      if (!text) return;
      if (navigator.clipboard && navigator.clipboard.writeText) {
        await navigator.clipboard.writeText(text);
      }
      const orig =
        btn.dataset.origText || (btn.dataset.origText = btn.textContent?.trim() || 'Copy');
      const prevTimer = timers.get(btn);
      if (prevTimer) window.clearTimeout(prevTimer);
      btn.textContent = 'Copied!';
      if (liveRegion) liveRegion.textContent = 'Copied code snippet to clipboard.';
      const timerId = window.setTimeout(() => {
        btn.textContent = orig;
      }, 1500);
      timers.set(btn, timerId);
    });
  });
</script>
