---
interface Props {
  currentPage?: 'home' | 'how-it-works' | 'spec' | 'go' | 'es' | 'none';
}

const { currentPage = 'home' } = Astro.props;

const pages = [
  { href: '/', key: 'home', label: 'Overview' },
  { href: '/how-it-works', key: 'how-it-works', label: 'How It Works' },
  { href: '/spec', key: 'spec', label: 'Specification' },
] as const;

const languages = [
  { href: '/go', key: 'go', label: 'Go' },
  { href: '/es', key: 'es', label: 'TypeScript / JS' },
] as const;

const activeLang = languages.find((l) => l.key === currentPage);
const activePageLabel =
  pages.find((p) => p.key === currentPage)?.label ??
  (activeLang ? `Languages: ${activeLang.label}` : 'Menu');
---

<header class="sticky top-0 z-50 bg-[#FAF8F2] border-b-2 border-ink no-print">
  <div class="max-w-7xl mx-auto px-3 sm:px-6 h-14 flex items-center justify-between gap-2 text-xs sm:text-base font-mono">
    <div class="flex items-center gap-2 sm:gap-5 min-w-0">
      <a
        href="/"
        class="font-bold bg-ink text-paper border-2 border-ink px-2.5 sm:px-3 py-1 rounded flex items-center gap-1.5 sm:gap-2 shrink-0 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
      >
        <span class="w-2.5 h-2.5 bg-acid inline-block shrink-0"></span>
        <span>OmniBuf</span>
      </a>

      <!-- Desktop Navigation -->
      <nav
        aria-label="Page navigation"
        class="hidden lg:flex items-center gap-2 font-medium min-w-0 py-1.5 px-0.5"
      >
        {pages.map((p) => (
          <a
            href={p.href}
            class="nav-link"
            data-active={currentPage === p.key ? 'true' : 'false'}
            aria-current={currentPage === p.key ? 'page' : undefined}
          >
            {p.label}
          </a>
        ))}

        <!-- Languages Dropdown -->
        <details id="lang-nav-menu" class="relative group">
          <summary
            data-active={activeLang ? 'true' : 'false'}
            class="nav-link list-none cursor-pointer flex items-center gap-1.5 select-none"
          >
            <span>{activeLang ? `Languages: ${activeLang.label}` : 'Languages'}</span>
            <span class="text-[10px] transition-transform group-open:rotate-180" aria-hidden="true">
              &#9662;
            </span>
          </summary>

          <div class="absolute left-0 mt-2 w-44 bg-[#FAF8F2] border-2 border-ink rounded-md shadow-[4px_4px_0px_#111111] py-1.5 z-50 divide-y divide-ink/15">
            {languages.map((lang) => {
              const isActive = currentPage === lang.key;
              return (
                <a
                  href={lang.href}
                  aria-current={isActive ? 'page' : undefined}
                  class={`flex items-center justify-between px-3.5 py-2 text-sm font-bold transition-colors ${
                    isActive ? 'bg-acid text-ink' : 'text-ink hover:bg-[#E5E0D5]'
                  }`}
                >
                  <span>{lang.label}</span>
                  {isActive && <span class="text-xs">&bull;</span>}
                </a>
              );
            })}
          </div>
        </details>
      </nav>

      <!-- Mobile Hamburger / Dropdown Selector -->
      <details id="mobile-nav-menu" class="relative lg:hidden group">
        <summary
          aria-label="Toggle navigation menu"
          class="list-none cursor-pointer px-2.5 py-1.5 bg-[#E5E0D5] text-ink border-2 border-ink rounded font-bold flex items-center gap-2 select-none shadow-[2px_2px_0px_#111111] group-open:bg-acid group-open:translate-x-[1px] group-open:translate-y-[1px] group-open:shadow-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
        >
          <svg
            class="w-4 h-4 stroke-current shrink-0"
            viewBox="0 0 24 24"
            fill="none"
            stroke-width="2.5"
            stroke-linecap="square"
            aria-hidden="true"
          >
            <path d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <span>{activePageLabel}</span>
          <span class="text-[10px] transition-transform group-open:rotate-180" aria-hidden="true">
            &#9662;
          </span>
        </summary>

        <nav
          aria-label="Mobile page navigation"
          class="absolute left-0 mt-2 w-52 bg-[#FAF8F2] border-2 border-ink rounded-md shadow-[4px_4px_0px_#111111] py-1.5 z-50 divide-y divide-ink/15"
        >
          {pages.map((p) => {
            const isActive = currentPage === p.key;
            return (
              <a
                href={p.href}
                aria-current={isActive ? 'page' : undefined}
                class={`flex items-center justify-between px-3.5 py-2.5 text-sm font-bold transition-colors ${
                  isActive ? 'bg-acid text-ink' : 'text-ink hover:bg-[#E5E0D5]'
                }`}
              >
                <span>{p.label}</span>
                {isActive && <span class="text-xs">&bull;</span>}
              </a>
            );
          })}
          <div class="px-3.5 pt-2 pb-1 text-[11px] font-bold uppercase text-ink/70 bg-[#E5E0D5]/50">
            Languages
          </div>
          {languages.map((lang) => {
            const isActive = currentPage === lang.key;
            return (
              <a
                href={lang.href}
                aria-current={isActive ? 'page' : undefined}
                class={`flex items-center justify-between px-3.5 py-2.5 text-sm font-bold transition-colors ${
                  isActive ? 'bg-acid text-ink' : 'text-ink hover:bg-[#E5E0D5]'
                }`}
              >
                <span>{lang.label}</span>
                {isActive && <span class="text-xs">&bull;</span>}
              </a>
            );
          })}
        </nav>
      </details>
    </div>

    <div class="flex items-center gap-2 shrink-0">
      <button
        type="button"
        id="search-trigger"
        aria-label="Search documentation (Command+K or /)"
        aria-haspopup="dialog"
        aria-controls="search-dialog"
        title="Search documentation (⌘K or /)"
        class="p-1.5 sm:px-2.5 sm:py-1.5 bg-[#FAF8F2] text-ink border-2 border-ink font-bold shadow-[2px_2px_0px_#111111] hover:translate-x-[-1px] hover:translate-y-[-1px] hover:shadow-[3px_3px_0px_#111111] active:translate-x-[1px] active:translate-y-[1px] active:shadow-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink transition text-xs sm:text-sm rounded flex items-center gap-1.5 cursor-pointer"
      >
        <svg
          class="w-4 h-4 stroke-current shrink-0"
          viewBox="0 0 24 24"
          fill="none"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <line x1="20" y1="20" x2="16.2" y2="16.2"></line>
        </svg>
        <span class="hidden sm:inline">Search</span>
        <kbd class="hidden md:inline-block px-1.5 py-0.5 text-[10px] font-bold bg-[#E5E0D5] text-ink border border-ink rounded leading-none">
          /
        </kbd>
      </button>

      <a
        href="https://github.com/sudorandom/omnibuf"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="OmniBuf on GitHub"
        class="px-2.5 sm:px-3.5 py-1.5 bg-ink text-paper border-2 border-ink font-bold shadow-[2px_2px_0px_#FF4F18] hover:translate-x-[-1px] hover:translate-y-[-1px] hover:shadow-[3px_3px_0px_#FF4F18] active:translate-x-[1px] active:translate-y-[1px] active:shadow-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink transition text-xs sm:text-sm rounded flex items-center gap-1.5"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 16 16" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path>
        </svg>
        <span class="hidden sm:inline">GitHub</span>
      </a>

      <button
        type="button"
        id="theme-toggle"
        aria-label="Toggle dark mode"
        title="Toggle dark mode"
        class="p-1.5 sm:px-2.5 sm:py-1.5 bg-[#E5E0D5] text-ink border-2 border-ink font-bold shadow-[2px_2px_0px_#111111] hover:translate-x-[-1px] hover:translate-y-[-1px] hover:shadow-[3px_3px_0px_#111111] active:translate-x-[1px] active:translate-y-[1px] active:shadow-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink transition rounded flex items-center justify-center cursor-pointer"
      >
        <!-- Sun icon (shown in dark mode) -->
        <svg
          data-theme-icon="sun"
          class="hidden w-4 h-4 stroke-current"
          viewBox="0 0 24 24"
          fill="none"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <!-- Moon icon (shown in light mode) -->
        <svg
          data-theme-icon="moon"
          class="w-4 h-4 stroke-current"
          viewBox="0 0 24 24"
          fill="none"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<dialog
  id="search-dialog"
  aria-label="Search documentation and wire specification"
  class="fixed inset-0 z-[70] m-auto mt-8 sm:mt-16 w-[calc(100%-1.5rem)] max-w-2xl max-h-[82vh] p-0 bg-[#FAF8F2] text-ink border-2 border-ink rounded-md shadow-[6px_6px_0px_#111111] font-mono overflow-hidden open:flex open:flex-col no-print"
>
  <div class="os-titlebar bg-[#E5E0D5] shrink-0">
    <span class="font-bold uppercase text-ink text-xs sm:text-sm">
      Search Documentation &amp; Spec
    </span>
    <div class="os-stripes"></div>
    <button
      type="button"
      id="search-close"
      aria-label="Close search"
      class="px-2 py-0.5 bg-[#FAF8F2] text-ink border border-ink rounded text-xs font-bold hover:bg-acid focus-visible:outline focus-visible:outline-2 focus-visible:outline-ink transition cursor-pointer"
    >
      ESC
    </button>
  </div>

  <div class="p-3 sm:p-3.5 border-b-2 border-ink bg-white flex items-center gap-2.5 shrink-0">
    <svg
      class="w-4 h-4 stroke-current text-ink/70 shrink-0"
      viewBox="0 0 24 24"
      fill="none"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="11" cy="11" r="7"></circle>
      <line x1="20" y1="20" x2="16.2" y2="16.2"></line>
    </svg>
    <input
      id="search-input"
      type="search"
      autocomplete="off"
      spellcheck="false"
      placeholder="Search wire types, Prefix-Varint, Opaque, Avro, Go, TypeScript..."
      aria-label="Search documentation"
      aria-controls="search-results"
      class="w-full bg-transparent text-ink placeholder:text-ink/55 text-sm sm:text-base font-mono focus:outline-none"
    />
    <button
      type="button"
      id="search-clear"
      class="hidden px-2 py-0.5 text-xs font-bold uppercase bg-[#E5E0D5] text-ink border border-ink rounded hover:bg-acid focus-visible:outline focus-visible:outline-2 focus-visible:outline-ink cursor-pointer shrink-0"
    >
      Clear
    </button>
  </div>

  <div
    id="search-results"
    role="listbox"
    aria-label="Search results"
    class="flex-1 overflow-y-auto p-3 sm:p-4 space-y-1.5"
  >
    <div id="search-default-links" class="space-y-3">
      <div class="text-[11px] font-bold uppercase text-ink/65 px-1">Quick Jump</div>
      <div class="grid sm:grid-cols-2 gap-2">
        <a
          href="/how-it-works#wire-types"
          data-search-item
          data-active="true"
          class="block p-2.5 rounded border-2 border-ink/25 hover:border-ink transition"
        >
          <div class="text-[10px] font-bold uppercase text-ink/65">How It Works</div>
          <div class="text-xs sm:text-sm font-bold text-ink mt-0.5">The 16 Wire Types</div>
        </a>
        <a
          href="/how-it-works#prefix-varints"
          data-search-item
          class="block p-2.5 rounded border-2 border-ink/25 hover:border-ink transition"
        >
          <div class="text-[10px] font-bold uppercase text-ink/65">How It Works</div>
          <div class="text-xs sm:text-sm font-bold text-ink mt-0.5">Prefix-Varints &amp; TZCNT</div>
        </a>
        <a
          href="/how-it-works#comparisons"
          data-search-item
          class="block p-2.5 rounded border-2 border-ink/25 hover:border-ink transition"
        >
          <div class="text-[10px] font-bold uppercase text-ink/65">How It Works</div>
          <div class="text-xs sm:text-sm font-bold text-ink mt-0.5">Format Comparisons</div>
        </a>
        <a
          href="/spec"
          data-search-item
          class="block p-2.5 rounded border-2 border-ink/25 hover:border-ink transition"
        >
          <div class="text-[10px] font-bold uppercase text-ink/65">Specification</div>
          <div class="text-xs sm:text-sm font-bold text-ink mt-0.5">
            Wire Format Specification v0.1
          </div>
        </a>
        <a
          href="/go"
          data-search-item
          class="block p-2.5 rounded border-2 border-ink/25 hover:border-ink transition"
        >
          <div class="text-[10px] font-bold uppercase text-ink/65">Go</div>
          <div class="text-xs sm:text-sm font-bold text-ink mt-0.5">
            Go Structs, .pb.go &amp; Benchmarks
          </div>
        </a>
        <a
          href="/es"
          data-search-item
          class="block p-2.5 rounded border-2 border-ink/25 hover:border-ink transition"
        >
          <div class="text-[10px] font-bold uppercase text-ink/65">TypeScript / JS</div>
          <div class="text-xs sm:text-sm font-bold text-ink mt-0.5">
            TypeScript Schemas &amp; Benchmarks
          </div>
        </a>
      </div>
    </div>
    <div id="search-dynamic-results" class="hidden space-y-1.5"></div>
  </div>

  <div class="px-3 sm:px-4 py-2 bg-[#E5E0D5] border-t-2 border-ink flex items-center justify-between gap-2 text-[11px] text-ink/80 shrink-0">
    <span id="search-status">Type to search all 5 pages</span>
    <div class="hidden sm:flex items-center gap-3">
      <span>
        <kbd class="px-1 py-0.5 bg-[#FAF8F2] border border-ink rounded text-[10px] font-bold">
          &uarr;&darr;
        </kbd>{' '}
        Navigate
      </span>
      <span>
        <kbd class="px-1 py-0.5 bg-[#FAF8F2] border border-ink rounded text-[10px] font-bold">
          &crarr;
        </kbd>{' '}
        Open
      </span>
      <span>
        <kbd class="px-1 py-0.5 bg-[#FAF8F2] border border-ink rounded text-[10px] font-bold">
          ESC
        </kbd>{' '}
        Close
      </span>
    </div>
  </div>
</dialog>

<script>
  const navMenus = [
    document.getElementById('mobile-nav-menu') as HTMLDetailsElement | null,
    document.getElementById('lang-nav-menu') as HTMLDetailsElement | null,
  ].filter((el): el is HTMLDetailsElement => el !== null);

  if (navMenus.length > 0) {
    document.addEventListener('click', (e) => {
      for (const menu of navMenus) {
        if (menu.open && !menu.contains(e.target as Node)) {
          menu.open = false;
        }
      }
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        for (const menu of navMenus) {
          if (menu.open) {
            menu.open = false;
          }
        }
      }
    });
    for (const menu of navMenus) {
      menu.addEventListener('focusout', (e) => {
        const next = e.relatedTarget as Node | null;
        if (menu.open && next && !menu.contains(next)) {
          menu.open = false;
        }
      });
    }
  }

  const themeToggle = document.getElementById('theme-toggle');
  const sunIcon = document.querySelector<SVGElement>('[data-theme-icon="sun"]');
  const moonIcon = document.querySelector<SVGElement>('[data-theme-icon="moon"]');

  function syncThemeIcons() {
    const isDark = document.documentElement.classList.contains('dark');
    if (sunIcon && moonIcon) {
      sunIcon.classList.toggle('hidden', !isDark);
      moonIcon.classList.toggle('hidden', isDark);
    }
    if (themeToggle) {
      themeToggle.setAttribute('aria-pressed', isDark ? 'true' : 'false');
    }
  }

  syncThemeIcons();

  if (themeToggle) {
    themeToggle.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      try {
        localStorage.setItem('omnibuf-theme', isDark ? 'dark' : 'light');
      } catch {
        // Ignore storage errors
      }
      syncThemeIcons();
    });
  }

  interface SearchEntry {
    page: string;
    section: string;
    title: string;
    url: string;
    text: string;
  }

  const searchDialog = document.getElementById('search-dialog') as HTMLDialogElement | null;
  const searchTrigger = document.getElementById('search-trigger') as HTMLButtonElement | null;
  const searchClose = document.getElementById('search-close') as HTMLButtonElement | null;
  const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
  const searchClear = document.getElementById('search-clear') as HTMLButtonElement | null;
  const searchDefaultLinks = document.getElementById('search-default-links');
  const searchDynamicResults = document.getElementById('search-dynamic-results');
  const searchStatus = document.getElementById('search-status');

  let searchIndexPromise: Promise<SearchEntry[]> | null = null;
  let searchEntries: SearchEntry[] | null = null;
  let activeIndex = 0;

  function loadSearchIndex(): Promise<SearchEntry[]> {
    if (searchEntries) return Promise.resolve(searchEntries);
    if (!searchIndexPromise) {
      searchIndexPromise = fetch('/search-index.json')
        .then((res) => (res.ok ? (res.json() as Promise<SearchEntry[]>) : []))
        .then((data) => {
          searchEntries = data;
          return data;
        })
        .catch(() => []);
    }
    return searchIndexPromise;
  }

  function escapeHtml(str: string): string {
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function escapeRegExp(str: string): string {
    return str.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  }

  function highlightMatches(text: string, tokens: string[]): string {
    if (tokens.length === 0) return escapeHtml(text);
    const pattern = tokens
      .slice()
      .sort((a, b) => b.length - a.length)
      .map(escapeRegExp)
      .join('|');
    if (!pattern) return escapeHtml(text);
    const regex = new RegExp(`(${pattern})`, 'gi');
    const parts = text.split(regex);
    return parts
      .map((part, i) =>
        i % 2 === 1
          ? `<mark class="underline decoration-[#FF4F18] decoration-2 underline-offset-2 font-bold bg-transparent text-inherit">${escapeHtml(part)}</mark>`
          : escapeHtml(part),
      )
      .join('');
  }

  function buildSnippet(text: string, tokens: string[]): string {
    if (!text) return '';
    const lower = text.toLowerCase();
    let firstPos = -1;
    for (const token of tokens) {
      const idx = lower.indexOf(token);
      if (idx !== -1 && (firstPos === -1 || idx < firstPos)) {
        firstPos = idx;
      }
    }
    const maxLen = 145;
    if (firstPos === -1 || text.length <= maxLen) {
      const slice = text.slice(0, maxLen);
      return highlightMatches(slice + (text.length > maxLen ? '…' : ''), tokens);
    }
    const start = Math.max(0, firstPos - 42);
    const end = Math.min(text.length, start + maxLen);
    const prefix = start > 0 ? '…' : '';
    const suffix = end < text.length ? '…' : '';
    return highlightMatches(prefix + text.slice(start, end) + suffix, tokens);
  }

  function getVisibleItems(): HTMLAnchorElement[] {
    if (!searchDialog) return [];
    const container =
      searchDynamicResults && !searchDynamicResults.classList.contains('hidden')
        ? searchDynamicResults
        : searchDefaultLinks;
    if (!container) return [];
    return Array.from(container.querySelectorAll<HTMLAnchorElement>('a[data-search-item]'));
  }

  function updateActiveItem(nextIndex: number) {
    const items = getVisibleItems();
    if (items.length === 0) {
      activeIndex = 0;
      return;
    }
    activeIndex = ((nextIndex % items.length) + items.length) % items.length;
    items.forEach((el, idx) => {
      const isSelected = idx === activeIndex;
      el.setAttribute('data-active', isSelected ? 'true' : 'false');
      if (isSelected) {
        el.scrollIntoView({ block: 'nearest' });
      }
    });
  }

  async function runSearch(rawQuery: string) {
    const query = rawQuery.trim();
    if (searchClear) {
      searchClear.classList.toggle('hidden', query.length === 0);
    }

    if (!query) {
      searchDefaultLinks?.classList.remove('hidden');
      searchDynamicResults?.classList.add('hidden');
      if (searchStatus) searchStatus.textContent = 'Type to search all 5 pages';
      updateActiveItem(0);
      return;
    }

    const entries = await loadSearchIndex();
    const lowerQuery = query.toLowerCase();
    const tokens = lowerQuery.split(/\s+/).filter(Boolean);

    const scored: { entry: SearchEntry; score: number }[] = [];
    for (const entry of entries) {
      const titleLower = entry.title.toLowerCase();
      const sectionLower = entry.section.toLowerCase();
      const pageLower = entry.page.toLowerCase();
      const textLower = entry.text.toLowerCase();
      const combined = `${titleLower} ${sectionLower} ${pageLower} ${textLower}`;

      let matchedTokens = 0;
      let score = 0;

      if (titleLower === lowerQuery) score += 150;
      else if (titleLower.startsWith(lowerQuery)) score += 90;
      else if (titleLower.includes(lowerQuery)) score += 60;

      if (textLower.includes(lowerQuery)) score += 35;

      for (const token of tokens) {
        if (!combined.includes(token)) continue;
        matchedTokens++;
        if (titleLower.includes(token)) score += 45;
        if (sectionLower.includes(token) || pageLower.includes(token)) score += 18;
        if (textLower.includes(token)) score += 12;
      }

      if (matchedTokens === tokens.length) {
        scored.push({ entry, score: score + 50 });
      } else if (matchedTokens > 0 && tokens.length > 1) {
        scored.push({ entry, score: score - 20 });
      }
    }

    scored.sort((a, b) => b.score - a.score);
    const topResults = scored.slice(0, 15);

    searchDefaultLinks?.classList.add('hidden');
    if (searchDynamicResults) {
      searchDynamicResults.classList.remove('hidden');
      if (topResults.length === 0) {
        const suggestions = [
          'Prefix-Varint',
          'WireArray',
          'Opaque',
          'Field #0',
          'Avro',
          'FlatBuffers',
        ];
        searchDynamicResults.innerHTML = `
          <div class="p-4 text-center space-y-3">
            <div class="text-sm font-bold text-ink">No sections matched &ldquo;${escapeHtml(query)}&rdquo;</div>
            <div class="text-xs text-ink/70">Try one of these topics:</div>
            <div class="flex flex-wrap justify-center gap-1.5 pt-1">
              ${suggestions
                .map(
                  (s) =>
                    `<button type="button" data-search-suggest="${escapeHtml(s)}" class="px-2.5 py-1 text-xs font-bold bg-[#E5E0D5] text-ink border border-ink rounded hover:bg-acid cursor-pointer">${escapeHtml(s)}</button>`,
                )
                .join('')}
            </div>
          </div>
        `;
        searchDynamicResults
          .querySelectorAll<HTMLButtonElement>('button[data-search-suggest]')
          .forEach((btn) => {
            btn.addEventListener('click', () => {
              const val = btn.getAttribute('data-search-suggest') || '';
              if (searchInput) {
                searchInput.value = val;
                searchInput.focus();
                void runSearch(val);
              }
            });
          });
      } else {
        searchDynamicResults.innerHTML = topResults
          .map(({ entry }, idx) => {
            const breadcrumb = entry.section
              ? `${escapeHtml(entry.page)} &rsaquo; ${escapeHtml(entry.section)}`
              : escapeHtml(entry.page);
            return `
              <a
                href="${escapeHtml(entry.url)}"
                data-search-item
                data-active="${idx === 0 ? 'true' : 'false'}"
                class="block p-2.5 sm:p-3 rounded border-2 border-transparent hover:border-ink transition"
              >
                <div class="text-[10px] font-bold uppercase text-ink/65 truncate">${breadcrumb}</div>
                <div class="text-xs sm:text-sm font-bold text-ink mt-0.5">${highlightMatches(entry.title, tokens)}</div>
                ${
                  entry.text
                    ? `<div class="text-xs text-ink/80 mt-1 line-clamp-2 leading-relaxed font-sans">${buildSnippet(entry.text, tokens)}</div>`
                    : ''
                }
              </a>
            `;
          })
          .join('');
      }
    }

    if (searchStatus) {
      searchStatus.textContent =
        topResults.length === 1 ? '1 match' : `${topResults.length} matches`;
    }
    updateActiveItem(0);
  }

  function openSearch() {
    if (!searchDialog) return;
    if (!searchDialog.open) {
      searchDialog.showModal();
    }
    void loadSearchIndex();
    if (searchInput) {
      searchInput.focus();
      searchInput.select();
      void runSearch(searchInput.value);
    }
  }

  function closeSearch() {
    if (searchDialog && searchDialog.open) {
      searchDialog.close();
    }
  }

  searchTrigger?.addEventListener('mouseenter', () => {
    void loadSearchIndex();
  });
  searchTrigger?.addEventListener('click', openSearch);
  searchClose?.addEventListener('click', closeSearch);

  searchClear?.addEventListener('click', () => {
    if (searchInput) {
      searchInput.value = '';
      searchInput.focus();
      void runSearch('');
    }
  });

  searchInput?.addEventListener('input', () => {
    void runSearch(searchInput.value);
  });

  searchDialog?.addEventListener('click', (e) => {
    if (e.target === searchDialog) {
      closeSearch();
      return;
    }
    const link = (e.target as HTMLElement | null)?.closest('a[data-search-item]');
    if (link) {
      closeSearch();
    }
  });

  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      if (searchDialog?.open) {
        closeSearch();
      } else {
        openSearch();
      }
      return;
    }

    const target = e.target as HTMLElement | null;
    const isEditable =
      target &&
      (target.tagName === 'INPUT' ||
        target.tagName === 'TEXTAREA' ||
        target.tagName === 'SELECT' ||
        target.isContentEditable);

    if (e.key === '/' && !isEditable && !e.metaKey && !e.ctrlKey && !e.altKey) {
      e.preventDefault();
      openSearch();
      return;
    }

    if (!searchDialog?.open) return;

    if (e.key === 'ArrowDown') {
      e.preventDefault();
      updateActiveItem(activeIndex + 1);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      updateActiveItem(activeIndex - 1);
    } else if (e.key === 'Enter') {
      const items = getVisibleItems();
      const current = items[activeIndex];
      if (current) {
        e.preventDefault();
        closeSearch();
        window.location.href = current.href;
      }
    }
  });
</script>
