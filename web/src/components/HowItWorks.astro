              >
                Int B1
              </text>
              <text
                x="227"
                y="143"
                fill="#FF4F18"
                font-family="IBM Plex Mono"
                font-size="11"
                font-weight="700"
                text-anchor="middle"
              >
                more? 1
              </text>

              <!-- Cell 3: Int B2 -->
              <rect
                x="274"
                y="102"
                width="78"
                height="52"
                rx="5"
                fill="#E5E0D5"
                stroke="#111111"
                stroke-width="2"
              />
              <text
                x="313"
                y="125"
                fill="#111111"
                font-family="IBM Plex Mono"
                font-size="13"
                font-weight="700"
                text-anchor="middle"
              >
                Int B2
              </text>
              <text
                x="313"
                y="143"
                fill="#FF4F18"
                font-family="IBM Plex Mono"
                font-size="11"
                font-weight="700"
                text-anchor="middle"
              >
                more? 1
              </text>

              <!-- Cell 4: Int B3 -->
              <rect
                x="360"
                y="102"
                width="78"
                height="52"
                rx="5"
                fill="#E5E0D5"
                stroke="#111111"
                stroke-width="2"
              />
              <text
                x="399"
                y="125"
                fill="#111111"
                font-family="IBM Plex Mono"
                font-size="13"
                font-weight="700"
                text-anchor="middle"
              >
                Int B3
              </text>
              <text
                x="399"
                y="143"
                fill="#FF4F18"
                font-family="IBM Plex Mono"
                font-size="11"
                font-weight="700"
