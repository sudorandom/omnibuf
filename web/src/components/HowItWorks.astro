---
import { Code } from 'astro:components';

const protoConsumeVarintCode = `func ConsumeVarint(b []byte) (v uint64, n int) {
    var y uint64
    if len(b) <= 0 { return 0, errCodeTruncated }
    v = uint64(b[0])
    if v < 0x80 { return v, 1 }
    v -= 0x80

    if len(b) <= 1 { return 0, errCodeTruncated }
    y = uint64(b[1]); v += y << 7
    if y < 0x80 { return v, 2 }
    v -= 0x80 << 7

    if len(b) <= 2 { return 0, errCodeTruncated }
    y = uint64(b[2]); v += y << 14
    if y < 0x80 { return v, 3 }
    v -= 0x80 << 14
    // ... repeats 7 more times up to b[9] ...
}`;

const omniReadVarintCode = `func ReadVarintAt(b []byte, pos int) (uint64, int) {
    b0 := b[pos]
    if (b0 & 1) != 0 {
        return uint64(b0 >> 1), pos + 1
    }
    if (b0 & 2) != 0 {
        return uint64(binary.LittleEndian.Uint16(b[pos:]) >> 2), pos + 2
    }
    if (b0 & 4) != 0 {
        return uint64(binary.LittleEndian.Uint32(b[pos:]) >> 3), pos + 4
    }
    return binary.LittleEndian.Uint64(b[pos+1:]), pos + 9
}`;

const nodeSchemaCode = `message Node {
  uint32 id = 16;  // 5,000,000 (4B int)
  bool active = 3; // true
  string city = 9; // "FRA" (Target)
}`;
---

<section id="how-it-works" class="pt-0 pb-12 sm:pb-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
  <div class="border-t-2 border-ink/20 divide-y-2 divide-ink/20">
    <!-- Row 1: Decode ints in a single load (Merged with Varint Code & Microbenchmarks) -->
    <div class="py-8 sm:py-10 space-y-6">
      <div class="grid lg:grid-cols-12 gap-6 lg:gap-8 items-start">
        <div class="lg:col-span-6 space-y-3">
          <h3 class="text-2xl sm:text-3xl font-bold uppercase tracking-tight leading-snug">
            Decode ints in a single load
          </h3>
          <p class="text-base sm:text-lg text-ink/85 leading-relaxed max-w-[65ch]">
            Instead of checking continuation bits on every byte in a loop, the trailing zeros in
            Byte 0 tell the CPU the exact byte width (<code>1</code>, <code>2</code>, <code>4</code>
            , or <code>9</code> bytes) right away via{' '}
            <a
              href="https://en.wikipedia.org/wiki/Find_first_set"
              target="_blank"
              rel="noopener"
              class="doc-link"
            >
              <code>TZCNT</code>
            </a>
            . Signed integers use{' '}
            <a
              href="https://protobuf.dev/programming-guides/encoding/#signed-ints"
              target="_blank"
              rel="noopener"
              class="doc-link"
            >
              ZigZag encoding
            </a>
            .
          </p>
          <p class="text-base sm:text-lg text-ink/85 leading-relaxed max-w-[65ch]">
            In Go's official Protobuf library (<code>protowire.ConsumeVarint</code>), decoding a
            single integer takes a 100-line unrolled function with 10 bounds checks and 10
            continuation-bit branches that the Go compiler cannot inline. OmniBuf's{' '}
            <code>ReadVarintAt</code> is 12 lines, inlines everywhere, and loads <code>1</code>,{' '}
            <code>2</code>, <code>4</code>, or <code>8</code> bytes in one unaligned hardware
            instruction.
          </p>
        </div>
        <div class="lg:col-span-6">
          <div class="p-4 bg-ink text-paper border-2 border-ink rounded-md font-mono text-sm sm:text-base grid sm:grid-cols-2 gap-2.5">
            <div class="flex items-center justify-between bg-[#1F1F1F] px-3.5 py-2 rounded border border-paper/15">
              <span>
                <code class="text-paper/75">vvvvvvv</code>
                <strong class="text-acid">1</strong>
              </span>
              <span class="px-2 py-0.5 bg-acid text-ink font-bold rounded text-xs sm:text-sm">
                1B (7b)
              </span>
            </div>
            <div class="flex items-center justify-between bg-[#1F1F1F] px-3.5 py-2 rounded border border-paper/15">
              <span>
                <code class="text-paper/75">vvvvvv</code>
                <strong class="text-acid">10</strong>
              </span>
              <span class="px-2 py-0.5 bg-acid text-ink font-bold rounded text-xs sm:text-sm">
                2B (14b)
              </span>
            </div>
            <div class="flex items-center justify-between bg-[#1F1F1F] px-3.5 py-2 rounded border border-paper/15">
              <span>
                <code class="text-paper/75">vvvvv</code>
                <strong class="text-acid">100</strong>
              </span>
              <span class="px-2 py-0.5 bg-acid text-ink font-bold rounded text-xs sm:text-sm">
                4B (29b)
              </span>
            </div>
            <div class="flex items-center justify-between bg-[#1F1F1F] px-3.5 py-2 rounded border border-paper/15">
              <span>
                <strong class="text-acid">00000000</strong>
              </span>
              <span class="px-2 py-0.5 bg-paper/20 text-paper font-bold rounded text-xs sm:text-sm">
                9B (64b)
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- Side-by-Side Code Comparison -->
      <div class="grid lg:grid-cols-2 gap-6 font-mono text-xs sm:text-sm">
        <div class="bg-ink border-2 border-ink rounded-md overflow-hidden flex flex-col">
          <div class="bg-[#E5E0D5] text-ink px-4 py-2.5 border-b-2 border-ink font-bold flex items-center justify-between">
            <span>
              Protobuf: <code>protowire.ConsumeVarint</code>
            </span>
            <span class="text-[#FF4F18] text-xs uppercase font-bold">
              100 Lines &bull; Cannot Inline
            </span>
          </div>
          <div class="p-4 overflow-x-auto leading-relaxed flex-1 [&>pre]:!bg-transparent [&>pre]:!p-0 [&>pre]:!m-0 [&>pre]:!border-0">
            <Code code={protoConsumeVarintCode} lang="go" theme="github-dark" />
          </div>
        </div>

        <div class="bg-ink border-2 border-ink rounded-md overflow-hidden flex flex-col">
          <div class="bg-acid text-ink px-4 py-2.5 border-b-2 border-ink font-bold flex items-center justify-between">
            <span>
              OmniBuf: <code>ReadVarintAt</code>
            </span>
            <span class="text-ink text-xs uppercase font-bold">
              12 Lines &bull; Inlines Everywhere
            </span>
          </div>
          <div class="p-4 overflow-x-auto leading-relaxed flex-1 [&>pre]:!bg-transparent [&>pre]:!p-0 [&>pre]:!m-0 [&>pre]:!border-0">
            <Code code={omniReadVarintCode} lang="go" theme="github-dark" />
          </div>
        </div>
      </div>

      <!-- Varint Microbenchmark Table -->
      <div class="overflow-x-auto border-2 border-ink rounded-md bg-white">
        <table class="w-full text-left border-collapse font-mono text-sm sm:text-base tabular-nums">
          <thead>
            <tr class="border-b-2 border-ink bg-[#E5E0D5]">
              <th class="p-3.5 sm:p-4 font-bold uppercase">Operation</th>
              <th class="p-3.5 sm:p-4 font-bold uppercase">
                Protobuf (<code>protowire</code>)
              </th>
              <th class="p-3.5 sm:p-4 font-bold uppercase">
                <code>vtprotobuf</code>
              </th>
              <th class="p-3.5 sm:p-4 font-bold uppercase bg-acid">
                OmniBuf <code>TZCNT</code>
              </th>
              <th class="p-3.5 sm:p-4 font-bold uppercase">Speedup</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-ink/15">
            <tr class="bg-white">
              <td class="p-3.5 sm:p-4 font-bold">Decode 1B Int</td>
              <td class="p-3.5 sm:p-4">1.27 ns</td>
              <td class="p-3.5 sm:p-4">0.79 ns</td>
              <td class="p-3.5 sm:p-4 font-bold bg-acid/25">0.35 ns</td>
              <td class="p-3.5 sm:p-4 font-bold text-[#FF4F18]">2x to 4x faster</td>
            </tr>
            <tr class="bg-[#FAF8F2]">
              <td class="p-3.5 sm:p-4 font-bold">Decode 2B Int</td>
              <td class="p-3.5 sm:p-4">1.26 ns</td>
              <td class="p-3.5 sm:p-4">1.26 ns</td>
              <td class="p-3.5 sm:p-4 font-bold bg-acid/25">0.78 ns</td>
              <td class="p-3.5 sm:p-4 font-bold text-[#FF4F18]">~40% faster</td>
            </tr>
            <tr class="bg-white">
              <td class="p-3.5 sm:p-4 font-bold">Decode 4B Int</td>
              <td class="p-3.5 sm:p-4">1.81 ns</td>
              <td class="p-3.5 sm:p-4">2.28 ns</td>
              <td class="p-3.5 sm:p-4 font-bold bg-acid/25">0.97 ns</td>
              <td class="p-3.5 sm:p-4 font-bold text-[#FF4F18]">~2x faster</td>
            </tr>
            <tr class="bg-[#FAF8F2]">
              <td class="p-3.5 sm:p-4 font-bold">Decode 8B Int</td>
              <td class="p-3.5 sm:p-4">4.83 ns</td>
              <td class="p-3.5 sm:p-4">5.04 ns</td>
              <td class="p-3.5 sm:p-4 font-bold bg-acid/25">1.54 ns</td>
              <td class="p-3.5 sm:p-4 font-bold text-[#FF4F18]">Over 3x faster</td>
            </tr>
            <tr class="bg-white">
              <td class="p-3.5 sm:p-4 font-bold">Decode 16 Mixed Ints</td>
              <td class="p-3.5 sm:p-4">38.1 ns</td>
              <td class="p-3.5 sm:p-4">39.7 ns</td>
              <td class="p-3.5 sm:p-4 font-bold bg-acid/25">25.2 ns</td>
              <td class="p-3.5 sm:p-4 font-bold text-[#FF4F18]">~35% faster</td>
            </tr>
            <tr class="bg-[#FAF8F2]">
              <td class="p-3.5 sm:p-4 font-bold">Skip 16 Mixed Ints</td>
              <td class="p-3.5 sm:p-4">38.3 ns</td>
              <td class="p-3.5 sm:p-4">39.7 ns</td>
              <td class="p-3.5 sm:p-4 font-bold bg-acid/25">24.7 ns</td>
              <td class="p-3.5 sm:p-4 font-bold text-[#FF4F18]">~35% faster</td>
            </tr>
            <tr class="bg-white">
              <td class="p-3.5 sm:p-4 font-bold">Encode 16 Mixed Ints</td>
              <td class="p-3.5 sm:p-4">60.4 ns</td>
              <td class="p-3.5 sm:p-4">59.4 ns</td>
              <td class="p-3.5 sm:p-4 font-bold bg-acid/25">37.6 ns</td>
              <td class="p-3.5 sm:p-4 font-bold text-[#FF4F18]">~35% faster</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Row 2: Single-Pass Encoding -->
    <div class="py-8 sm:py-10 grid lg:grid-cols-12 gap-6 lg:gap-8 items-center">
      <div class="lg:col-span-6 space-y-2.5">
        <h3 class="text-2xl sm:text-3xl font-bold uppercase tracking-tight leading-snug">
          Reserve 2 bytes &amp; patch after
        </h3>
        <p class="text-base sm:text-lg text-ink/85 leading-relaxed max-w-[65ch]">
          Protobuf requires shortest-length varints, so encoders must measure every child object
          before writing. In OmniBuf, a 2-byte Prefix-Varint (<code>TZCNT=1</code>) is valid for any
          length under 16 KB, so the encoder reserves 2 bytes, writes forward in one pass, and fills
          in the length at the end (automatically expanding in place to 4 or 9 bytes if a container
          exceeds 16 KB).
        </p>
      </div>
      <div class="lg:col-span-6">
        <div class="p-4 bg-ink text-paper border-2 border-ink rounded-md font-mono text-sm grid sm:grid-cols-2 gap-3">
          <div class="bg-[#1F1F1F] p-3 rounded border border-paper/15">
            <div class="text-paper/75 text-xs mb-1.5">1. Reserve 2-byte blank slot</div>
            <div class="flex flex-wrap items-center gap-1.5 text-xs sm:text-sm">
              <span class="px-2 py-0.5 bg-paper/20 rounded">Tag #9</span>
              <span class="px-2 py-0.5 border border-dashed border-acid text-acid font-bold rounded">
                [00 00]
              </span>
              <span class="text-paper/70">&rarr; write</span>
            </div>
          </div>
          <div class="bg-[#1F1F1F] p-3 rounded border border-paper/15">
            <div class="text-paper/75 text-xs mb-1.5">2. Backpatch 2B length at end</div>
            <div class="flex flex-wrap items-center gap-1.5 text-xs sm:text-sm">
              <span class="px-2 py-0.5 bg-paper/20 rounded">Tag #9</span>
              <span class="px-2 py-0.5 bg-acid text-ink font-bold rounded">Len=7B</span>
              <span class="px-2 py-0.5 bg-[#FF4F18] text-white rounded">[7B]</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Row 3: 4-Bit Self-Describing Tags + Header Hopping (Merged with Skip Containers in One Step) -->
    <div class="py-8 sm:py-10 space-y-6">
      <div class="grid lg:grid-cols-12 gap-6 lg:gap-8 items-start">
        <div class="lg:col-span-6 space-y-2.5">
          <h3 class="text-2xl sm:text-3xl font-bold uppercase tracking-tight leading-snug">
            0-byte bools, explicit types &amp; 1-step skipping
          </h3>
          <p class="text-base sm:text-lg text-ink/85 leading-relaxed max-w-[65ch]">
            Widening wire types from 3 bits to 4 bits (<code>0..15</code>) puts booleans directly
            inside the tag byte (<strong>0 value bytes</strong>), distinguishes unsigned (
            <code>WireUint</code>, <code>WireUintArr</code>) from ZigZag-signed (
            <code>WireSint</code>, <code>WireSintArr</code>) integers on the wire, and wraps all
            arrays, maps, and sub-messages in length-prefixed containers so readers can skip any
            field or container in a single step (<code>pos += byteLen</code>).
          </p>
        </div>
        <div class="lg:col-span-6">
          <div class="p-4 bg-ink text-paper border-2 border-ink rounded-md font-mono text-sm space-y-3">
            <div class="grid grid-cols-12 text-center text-xs sm:text-sm font-bold rounded overflow-hidden border border-paper/30">
              <div class="col-span-5 bg-paper/15 py-2 text-paper border-r border-paper/30">
                Field #
              </div>
              <div class="col-span-5 bg-acid text-ink py-2 border-r border-ink">4-Bit Type</div>
              <div class="col-span-2 bg-[#FF4F18] text-white py-2">TZ</div>
            </div>
            <div class="flex flex-wrap justify-between gap-2 text-xs sm:text-sm text-paper/90">
              <span>
                <code>Type 1, 2</code> (Bool): <strong class="text-acid">0 Value Bytes</strong>
              </span>
              <span>
                Skip Container: <strong class="text-acid">pos += byteLen</strong>
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- Schema + Explanation + Color Key -->
      <div class="grid lg:grid-cols-12 gap-5 items-center bg-[#FAF8F2] border-2 border-ink rounded-md p-5">
        <div class="lg:col-span-5 font-mono">
          <div class="bg-ink text-paper p-4 rounded text-sm leading-relaxed [&>pre]:!bg-transparent [&>pre]:!p-0 [&>pre]:!m-0 [&>pre]:!border-0">
            <Code code={nodeSchemaCode} lang="protobuf" theme="github-dark" />
          </div>
        </div>
        <div class="lg:col-span-7 space-y-3">
          <p class="text-base sm:text-lg text-ink/90 leading-relaxed">
            To skip past <code>id</code> (a 2-byte tag + 4-byte integer) and <code>active</code> (a
            boolean) to reach <code>city</code>, Protobuf has to bounce across{' '}
            <strong>every single varint byte</strong> to check continuation bits. OmniBuf reads the
            width from the first byte and leaps over each tag, scalar, or container in one jump.
          </p>
          <!-- Simple Color Key -->
          <div class="flex flex-wrap items-center gap-4 text-xs sm:text-sm font-mono pt-1">
            <span class="flex items-center gap-2 font-bold">
              <span class="w-4 h-4 bg-ink inline-block border border-ink rounded-sm"></span> Tag
              Byte
            </span>
            <span class="flex items-center gap-2 font-bold">
              <span class="w-4 h-4 bg-[#E5E0D5] inline-block border border-ink rounded-sm"></span>{' '}
              Value Byte
            </span>
            <span class="flex items-center gap-2 font-bold">
              <span class="w-4 h-4 bg-acid inline-block border border-ink rounded-sm"></span> Target
              Field
            </span>
          </div>
        </div>
      </div>

      <!-- DESKTOP SVG: Side-by-Side Byte Strips with Bouncing vs Leaping Arrows -->
      <div class="hidden md:block bg-white border-2 border-ink rounded-md p-4 sm:p-6 shadow-[4px_4px_0px_#111]">
        <svg
          viewBox="0 0 860 390"
          class="w-full h-auto select-none"
