              <!-- ============================================================ -->
              <!-- TRACK 2: OMNIBUF (3 Direct Header Jumps)                     -->
              <!-- ============================================================ -->
              <text
                x="20"
                y="234"
                fill="#111111"
                font-family="IBM Plex Mono"
                font-size="14"
                font-weight="700"
              >
                OMNIBUF: Leaps whole tags &amp; values in one jump (3 stops)
              </text>

              <!-- Jump 1: Tag B1 (55) -> Int B1 (227) (Leaps over Tag B2) -->
              <path
                d="M 63 298 Q 141 245 216 296"
                fill="none"
                stroke="#111111"
                stroke-width="3"
                marker-end="url(#hop-omni)"
              />
              <rect
                x="92"
                y="248"
                width="96"
                height="20"
                rx="4"
                fill="#D4FF33"
                stroke="#111111"
