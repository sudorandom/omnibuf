          <!-- Bounce Stop Dots -->
          <circle cx="55" cy="96" r="4" fill="#FF4F18" />
          <circle cx="141" cy="96" r="4" fill="#FF4F18" />
          <circle cx="227" cy="96" r="4" fill="#FF4F18" />
