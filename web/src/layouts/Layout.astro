---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'OmniBuf: Fast, Self-Describing Wire Format for .proto',
  description = 'Drop-in binary wire format for .proto schemas with single-pass encoding, branchless Prefix-Varints, raw message concatenation, and schema-less inspection.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://omnibuf.dev');
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="OmniBuf" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Space+Grotesk:wght@500;600;700&family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="font-display antialiased selection:bg-[#FF4F18] selection:text-white">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[60] os-btn px-3 py-1.5 bg-acid text-ink font-mono text-sm font-bold rounded"
    >
      Skip to main content
    </a>
    <slot />
  </body>
</html>
