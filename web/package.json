{
  "name": "omnibuf-web",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "eslint . && astro check",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "pages:preview": "astro build && wrangler pages dev ./dist",
    "pages:deploy": "astro build && (wrangler pages project list | grep -q omnibuf || wrangler pages project create omnibuf --production-branch=main) && wrangler pages deploy ./dist --project-name=omnibuf --branch=main"
  },
  "dependencies": {
    "@astrojs/tailwind": "^6.0.2",
    "astro": "^5.5.0",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.72.0",
    "wrangler": "^4.152.0"
  }
}
